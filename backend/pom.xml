<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.iortatechnxt</groupId>
  <artifactId>brokerverse-backend</artifactId>
  <version>1.0.0</version>
  <name>iNXT BrokerVerse - Backend</name>
  <description>Insurance General Ledger and Finance platform (REST API)</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Library versions -->
    <springdoc.version>2.8.9</springdoc.version>
    <jjwt.version>0.12.6</jjwt.version>
    <openpdf.version>2.0.3</openpdf.version>
    <poi.version>5.4.1</poi.version>
    <re2j.version>1.8</re2j.version>
    <zxing.version>3.5.3</zxing.version>
    <zonky.embedded-db.version>2.6.0</zonky.embedded-db.version>
    <zonky.embedded-pg.version>2.1.0</zonky.embedded-pg.version>
    <archunit.version>1.4.1</archunit.version>
    <jedis-mock.version>1.1.19</jedis-mock.version>
    <awssdk.version>2.55.6</awssdk.version>
    <surefire.runOrder>alphabetical</surefire.runOrder>

    <!-- Security fixes ahead of the Spring Boot managed versions (dependency gate, CVSS >= 7, and
         the medium findings with a fix). Remove an override once the parent manages the same or a
         newer version. -->
    <tomcat.version>10.1.60</tomcat.version>
    <netty.version>4.1.138.Final</netty.version>
    <jackson-bom.version>2.21.7</jackson-bom.version>
    <postgresql.version>42.7.13</postgresql.version>
    <commons-lang3.version>3.20.0</commons-lang3.version>
    <log4j2.version>2.25.5</log4j2.version>
    <lz4-java.version>1.11.4</lz4-java.version>
    <bouncycastle.version>1.86</bouncycastle.version>

    <!-- Quality tooling versions -->
    <checkstyle-plugin.version>3.6.0</checkstyle-plugin.version>
    <checkstyle.version>10.26.1</checkstyle.version>
    <pmd-plugin.version>3.27.0</pmd-plugin.version>
    <spotbugs-plugin.version>4.9.3.2</spotbugs-plugin.version>
    <findsecbugs.version>1.14.0</findsecbugs.version>
    <jacoco.version>0.8.15</jacoco.version>
    <spotless.version>2.46.1</spotless.version>
    <google-java-format.version>1.28.0</google-java-format.version>

    <!-- Supply chain: software bill of materials and the dependency vulnerability gate
         (docs/quality/QUALITY_GATES.md "Dependency and supply-chain checks") -->
    <cyclonedx-plugin.version>2.9.3</cyclonedx-plugin.version>
    <dependency-check.version>13.0.0</dependency-check.version>
    <dependency-check.failBuildOnCVSS>7</dependency-check.failBuildOnCVSS>

    <!-- Quality gate thresholds (see docs/quality/QUALITY_GATES.md) -->
    <jacoco.line.minimum>0.80</jacoco.line.minimum>
    <jacoco.branch.minimum>0.65</jacoco.branch.minimum>

    <!-- SonarQube / SonarCloud (used by `mvn sonar:sonar` in CI) -->
    <sonar.projectKey>iortatechnxt_brokerverse-backend</sonar.projectKey>
    <sonar.coverage.jacoco.xmlReportPaths>${project.build.directory}/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
    <sonar.coverage.exclusions>**/config/**,**/*Application.java,**/dto/**</sonar.coverage.exclusions>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- LZ4 compression of the Kafka client (security fix). -->
      <dependency>
        <groupId>at.yawk.lz4</groupId>
        <artifactId>lz4-java</artifactId>
        <version>${lz4-java.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Web, persistence, security -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-mail</artifactId>
    </dependency>
    <!-- Required by OpenPDF to encrypt outbound PDF documents (AES-256). -->
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
      <version>${bouncycastle.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <!-- Validation of the API gateway tokens of /integration/** (IntegrationSecurityConfig). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Shared state (Redis 7: caches, job locks, token denylist, counters) and event streaming
         (Apache Kafka 3.6+: transactional outbox relay, consumers). See
         docs/architecture/PLATFORM_CACHE_AND_EVENTS.md. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-cache</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>

    <!-- JWT -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>${jjwt.version}</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>

    <!-- API documentation (Swagger UI at /swagger-ui.html) -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <!-- Report rendering -->
    <dependency>
      <groupId>com.github.librepdf</groupId>
      <artifactId>openpdf</artifactId>
      <version>${openpdf.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>${poi.version}</version>
    </dependency>
    <!-- Linear-time regular expressions for patterns entered by administrators (no ReDoS) -->
    <dependency>
      <groupId>com.google.re2j</groupId>
      <artifactId>re2j</artifactId>
      <version>${re2j.version}</version>
    </dependency>

    <!-- QR code of the enrolment of an authenticator app (second factor), drawn on the server -->
    <dependency>
      <groupId>com.google.zxing</groupId>
      <artifactId>core</artifactId>
      <version>${zxing.version}</version>
    </dependency>

    <!-- Document storage (common.storage S3FileStore): Amazon S3 with SSE-KMS and presigned links;
         STS for the IAM role of the service account (web identity). Synchronous clients only, on the
         JDK HTTP client (url-connection-client): Apache HttpClient 5 on the classpath would change the
         HTTP client Spring picks for the application's own REST clients. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
      <version>${awssdk.version}</version>
      <exclusions>
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>netty-nio-client</artifactId>
        </exclusion>
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>apache5-client</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>sts</artifactId>
      <version>${awssdk.version}</version>
      <exclusions>
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>netty-nio-client</artifactId>
        </exclusion>
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>apache5-client</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>url-connection-client</artifactId>
      <version>${awssdk.version}</version>
    </dependency>

    <!-- Metrics -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.zonky.test</groupId>
      <artifactId>embedded-database-spring-test</artifactId>
      <version>${zonky.embedded-db.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.zonky.test</groupId>
      <artifactId>embedded-postgres</artifactId>
      <version>${zonky.embedded-pg.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- In-JVM Kafka (KRaft) broker for the outbox relay / consumer tests; no Docker needed. -->
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Pure-Java Redis protocol server for the Redis adapter tests; no Docker or native binary. -->
    <dependency>
      <groupId>com.github.fppt</groupId>
      <artifactId>jedis-mock</artifactId>
      <version>${jedis-mock.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>brokerverse-backend</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <!-- META-INF/build-info.properties: version and build time for the About dialog -->
          <execution>
            <goals>
              <goal>build-info</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <includes>
            <include>**/*Test.java</include>
            <include>**/*IT.java</include>
          </includes>
          <!-- Deterministic class order so CI and local runs match; integration tests share one
               database and must still pass in any order (checked with -Dsurefire.runOrder=...). -->
          <runOrder>${surefire.runOrder}</runOrder>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <compilerArgs>
            <arg>-Xlint:all</arg>
            <arg>-Xlint:-processing</arg>
            <arg>-Xlint:-serial</arg>
            <arg>-Werror</arg>
            <arg>-parameters</arg>
          </compilerArgs>
        </configuration>
      </plugin>

      <!-- Formatting: google-java-format. `mvn spotless:apply` fixes, `verify` fails on drift. -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <googleJavaFormat>
              <version>${google-java-format.version}</version>
            </googleJavaFormat>
            <removeUnusedImports/>
            <importOrder/>
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>

      <!-- Coding standards -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>${checkstyle-plugin.version}</version>
        <dependencies>
          <dependency>
            <groupId>com.puppycrawl.tools</groupId>
            <artifactId>checkstyle</artifactId>
            <version>${checkstyle.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <configLocation>quality/checkstyle.xml</configLocation>
          <consoleOutput>true</consoleOutput>
          <failOnViolation>true</failOnViolation>
          <violationSeverity>warning</violationSeverity>
          <includeTestSourceDirectory>true</includeTestSourceDirectory>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>

      <!-- Static analysis: code smells, complexity, duplication (Sonar-equivalent rules) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-pmd-plugin</artifactId>
        <version>${pmd-plugin.version}</version>
        <configuration>
          <rulesets>
            <ruleset>quality/pmd-ruleset.xml</ruleset>
          </rulesets>
          <printFailingErrors>true</printFailingErrors>
          <failurePriority>3</failurePriority>
          <targetJdk>${java.version}</targetJdk>
          <minimumTokens>120</minimumTokens>
          <includeTests>false</includeTests>
          <linkXRef>false</linkXRef>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
              <goal>cpd-check</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>

      <!-- Static analysis: bugs + security vulnerabilities (FindSecBugs) -->
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <version>${spotbugs-plugin.version}</version>
        <configuration>
          <effort>Max</effort>
          <threshold>Low</threshold>
          <failOnError>true</failOnError>
          <excludeFilterFile>quality/spotbugs-exclude.xml</excludeFilterFile>
          <plugins>
            <plugin>
              <groupId>com.h3xstream.findsecbugs</groupId>
              <artifactId>findsecbugs-plugin</artifactId>
              <version>${findsecbugs.version}</version>
            </plugin>
          </plugins>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>

      <!-- Software bill of materials (CycloneDX 1.6, JSON and XML) of the runtime dependencies:
           target/bom.json, published by the pipeline as a build artefact. -->
      <plugin>
        <groupId>org.cyclonedx</groupId>
        <artifactId>cyclonedx-maven-plugin</artifactId>
        <version>${cyclonedx-plugin.version}</version>
        <configuration>
          <projectType>application</projectType>
          <schemaVersion>1.6</schemaVersion>
          <outputFormat>all</outputFormat>
          <outputName>bom</outputName>
          <includeTestScope>false</includeTestScope>
          <includeProvidedScope>false</includeProvidedScope>
          <includeSystemScope>false</includeSystemScope>
        </configuration>
        <executions>
          <execution>
            <id>sbom</id>
            <phase>package</phase>
            <goals>
              <goal>makeBom</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Test coverage gate -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <configuration>
          <excludes>
            <exclude>**/BrokerVerseApplication.class</exclude>
            <exclude>**/config/**</exclude>
            <exclude>**/dto/**</exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.line.minimum}</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.branch.minimum}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
    <pluginManagement>
      <plugins>
        <!-- Known vulnerabilities (NVD) of the dependencies: the pipeline runs
             `mvn org.owasp:dependency-check-maven:check` and fails at CVSS 7 or above. A finding is
             fixed by upgrading the library; a suppression needs a reason and an expiry date
             (quality/dependency-check-suppressions.xml). NVD_API_KEY comes from the pipeline secrets. -->
        <plugin>
          <groupId>org.owasp</groupId>
          <artifactId>dependency-check-maven</artifactId>
          <version>${dependency-check.version}</version>
          <configuration>
            <failBuildOnCVSS>${dependency-check.failBuildOnCVSS}</failBuildOnCVSS>
            <suppressionFiles>
              <suppressionFile>${project.basedir}/quality/dependency-check-suppressions.xml</suppressionFile>
            </suppressionFiles>
            <failOnError>true</failOnError>
            <nvdApiKeyEnvironmentVariable>NVD_API_KEY</nvdApiKeyEnvironmentVariable>
            <skipTestScope>true</skipTestScope>
            <skipProvidedScope>true</skipProvidedScope>
            <skipSystemScope>true</skipSystemScope>
            <formats>
              <format>HTML</format>
              <format>JSON</format>
              <format>SARIF</format>
            </formats>
            <!-- Java dependencies only; the web client has its own gate (npm audit). -->
            <nodeAnalyzerEnabled>false</nodeAnalyzerEnabled>
            <nodeAuditAnalyzerEnabled>false</nodeAuditAnalyzerEnabled>
            <retireJsAnalyzerEnabled>false</retireJsAnalyzerEnabled>
            <assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
            <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
