<?xml version="1.0" encoding="UTF-8"?>
<!--
  Documented, deliberate SpotBugs exclusions. Every entry states WHY it is safe.
-->
<FindBugsFilter>
  <!--
    EI_EXPOSE_REP / EI_EXPOSE_REP2: Spring beans receive collaborators via constructor
    injection and JPA entities expose managed associations by design. Both patterns are
    framework-managed, not caller-controlled mutable state.
  -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
  <!-- CT_CONSTRUCTOR_THROW: Spring-managed singletons are never subclassed by untrusted code. -->
  <Match>
    <Bug pattern="CT_CONSTRUCTOR_THROW"/>
  </Match>
  <!--
    SPRING_ENDPOINT (FindSecBugs): informational marker for every @RestController method.
    All endpoints are protected by Spring Security + @PreAuthorize (see SecurityConfig).
  -->
  <Match>
    <Bug pattern="SPRING_ENDPOINT"/>
  </Match>
  <!--
    CRLF_INJECTION_LOGS: neutralised centrally. The message converter of logback-spring.xml
    (CrlfSafeMessageConverter, bound to %m / %msg / %message) replaces CR/LF in every message with
    '_' in every pattern layout, so user data can never forge log lines, whichever logger call
    writes it and whatever pattern a deployment configures.
  -->
  <Match>
    <Bug pattern="CRLF_INJECTION_LOGS"/>
  </Match>
  <!--
    SERVLET_CONTENT_TYPE: JsonBodyLimitFilter reads the request's Content-Type only to decide whether
    the JSON size limit applies; a false type gains nothing (the controllers parse JSON only for a
    JSON content type, and every other body has its own limit).
  -->
  <Match>
    <Class name="com.iortatechnxt.brokerverse.config.JsonBodyLimitFilter"/>
    <Bug pattern="SERVLET_CONTENT_TYPE"/>
  </Match>
  <!--
    SERVLET_HEADER: the Authorization header is read only to extract a bearer token whose HMAC
    signature, issuer and expiry are then verified; an altered header simply fails validation.
  -->
  <Match>
    <Class name="com.iortatechnxt.brokerverse.security.service.JwtAuthenticationFilter"/>
    <Bug pattern="SERVLET_HEADER"/>
  </Match>
  <!--
    SERVLET_HEADER in SecurityConfig: the presence of an Authorization header only exempts the
    request from CSRF tokens. Browsers cannot add that header to a cross-site request without a
    CORS preflight that the origin allow-list rejects, and a forged token fails authentication.
  -->
  <Match>
    <Class name="com.iortatechnxt.brokerverse.config.SecurityConfig"/>
    <Bug pattern="SERVLET_HEADER"/>
  </Match>
  <!--
    SERVLET_HEADER in IntegrationSecurityConfig: same rule for the gateway chain. The Authorization
    header only exempts the request from CSRF tokens; the gateway token is then verified (key set,
    issuer, audience, expiry, scopes) and a forged or missing token is refused.
  -->
  <Match>
    <Class name="com.iortatechnxt.brokerverse.config.IntegrationSecurityConfig"/>
    <Bug pattern="SERVLET_HEADER"/>
  </Match>
  <!--
    SERVLET_PARAMETER in DataScopeInterceptor: the companyId and branchId parameters are read only to
    refuse a company or branch outside the user's data scope. They are parsed as numbers (anything
    else is ignored and refused later by the request binding), compared with the user's granted ids
    and never used in a query, a path or a response.
  -->
  <Match>
    <Class name="com.iortatechnxt.brokerverse.security.api.DataScopeInterceptor"/>
    <Bug pattern="SERVLET_PARAMETER"/>
  </Match>
  <!--
    SERVLET_HEADER in CorrelationIdFilter: X-Correlation-Id is only a log / event correlation label.
    It is used only when it matches [A-Za-z0-9_-]{1,64} (otherwise a new UUID is generated), carries
    no authority and is never used in a query or a file name.
  -->
  <Match>
    <Class name="com.iortatechnxt.brokerverse.events.service.CorrelationIdFilter"/>
    <Bug pattern="SERVLET_HEADER"/>
  </Match>
  <!--
    PATH_TRAVERSAL_IN / PATH_TRAVERSAL_OUT in LocalFileStore (developer, test and seed stacks only;
    refused in production): object keys are validated by ObjectRef ([a-z0-9/_.-], no "..", no empty
    segment) and every resolved path is normalised and checked to stay under the configured root.
  -->
  <Match>
    <Class name="com.iortatechnxt.brokerverse.common.storage.LocalFileStore"/>
    <Bug pattern="PATH_TRAVERSAL_IN,PATH_TRAVERSAL_OUT"/>
  </Match>
  <!--
    IMPROPER_UNICODE in the Data Migration module: legacy codes, flags, file names, checksums and
    matching keys are compared case-insensitively or normalised to match legacy data with BIBS
    data. No authorisation, path or security decision depends on these comparisons.
  -->
  <Match>
    <Package name="~com\.iortatechnxt\.brokerverse\.migration(\..*)?"/>
    <Bug pattern="IMPROPER_UNICODE"/>
  </Match>
  <!--
    SQL_INJECTION_SPRING_JDBC in TargetCodes: the SQL text is taken from a fixed map of constant
    queries, one per kind of code map target; the only variable part is a bound parameter.
  -->
  <Match>
    <Class name="com.iortatechnxt.brokerverse.migration.mapping.service.TargetCodes"/>
    <Bug pattern="SQL_INJECTION_SPRING_JDBC"/>
  </Match>
  <!--
    SQL_INJECTION_SPRING_JDBC in the Configuration Promotion engine: the statements are built from
    table and column names read from the database catalogue (information_schema) for the tables the
    configuration catalogue lists; every name is checked against [a-z][a-z0-9_]* and quoted
    (engine.Sql.quote), and every value is a bound parameter. No request value becomes SQL text.
  -->
  <Match>
    <Package name="com.iortatechnxt.brokerverse.configpromo.engine"/>
    <Bug pattern="SQL_INJECTION_SPRING_JDBC"/>
  </Match>
  <!--
    The uploads of the configuration screens write the records of a row by natural key: the table
    and column names come from the upload handlers (constants) and are checked against the schema
    read from the database; every value is a bound parameter.
  -->
  <Match>
    <Class name="com.iortatechnxt.brokerverse.configpromo.upload.UploadSupport"/>
    <Bug pattern="SQL_INJECTION_SPRING_JDBC"/>
  </Match>
  <!-- Generated/test code is not part of the production artefact. -->
  <Match>
    <Class name="~.*Test.*"/>
  </Match>
  <!--
    SQL_INJECTION_SPRING_JDBC in FileContentMigrationService: the statements are constants that the
    owning modules declare as LegacyFileTable beans in code (no request, parameter or table value
    is concatenated); every value is a bound parameter.
  -->
  <Match>
    <Class name="com.iortatechnxt.brokerverse.storage.service.FileContentMigrationService"/>
    <Bug pattern="SQL_INJECTION_SPRING_JDBC"/>
  </Match>
  <!--
    IMPROPER_UNICODE (FindSecBugs) in Submitted Policies: the case mappings (Locale.ROOT) only
    normalise the ASCII codes of the bank's files and of the rule values (segments, statuses, business
    types, vehicle types) before they are compared with list-of-values codes; no security decision
    depends on them.
  -->
  <Match>
    <Package name="~com\.iortatechnxt\.brokerverse\.submitted\..*"/>
    <Bug pattern="IMPROPER_UNICODE"/>
  </Match>
  <!--
    IMPROPER_UNICODE in DpListHandler: the branch code comes from the DP list file name, which the
    NAME pattern limits to ASCII letters, digits, spaces, dots and hyphens; it is upper-cased only to
    compare it with the head-office code of the client profile. No security decision depends on it.
  -->
  <Match>
    <Class name="com.iortatechnxt.brokerverse.commission.service.DpListHandler"/>
    <Bug pattern="IMPROPER_UNICODE"/>
  </Match>
  <!--
    COOKIE_USAGE in RefreshCookies: the refresh token of the sign-in session is meant to live in a
    cookie, and only there: HttpOnly (never readable by scripts), Secure outside a developer's
    machine, SameSite=Strict, limited to /api/v1/auth, a 256-bit random value of which the server
    keeps only the SHA-256, replaced on every use and revoked with the session.
  -->
  <Match>
    <Class name="com.iortatechnxt.brokerverse.security.api.RefreshCookies"/>
    <Bug pattern="COOKIE_USAGE"/>
  </Match>
</FindBugsFilter>
