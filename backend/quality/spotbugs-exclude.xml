<?xml version="1.0" encoding="UTF-8"?>
<!--
  Documented, deliberate SpotBugs exclusions. Every entry states WHY it is safe.
-->
<FindBugsFilter>
  <!--
    EI_EXPOSE_REP / EI_EXPOSE_REP2: Spring beans receive collaborators via constructor
    injection and JPA entities expose managed associations by design. Both patterns are
    framework-managed, not caller-controlled mutable state.
  -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
  <!-- CT_CONSTRUCTOR_THROW: Spring-managed singletons are never subclassed by untrusted code. -->
  <Match>
    <Bug pattern="CT_CONSTRUCTOR_THROW"/>
  </Match>
  <!--
    SPRING_ENDPOINT (FindSecBugs): informational marker for every @RestController method.
    All endpoints are protected by Spring Security + @PreAuthorize (see SecurityConfig).
  -->
  <Match>
    <Bug pattern="SPRING_ENDPOINT"/>
  </Match>
  <!--
    CRLF_INJECTION_LOGS: neutralised centrally. The log layout (application.yml
    logging.pattern.console) replaces CR/LF in every message with '_', so user data can never
    forge log lines, whichever logger call writes it.
  -->
  <Match>
    <Bug pattern="CRLF_INJECTION_LOGS"/>
  </Match>
  <!--
    SERVLET_HEADER: the Authorization header is read only to extract a bearer token whose HMAC
    signature, issuer and expiry are then verified; an altered header simply fails validation.
  -->
  <Match>
    <Class name="com.iortatechnxt.brokerverse.security.service.JwtAuthenticationFilter"/>
    <Bug pattern="SERVLET_HEADER"/>
  </Match>
  <!--
    SERVLET_HEADER in SecurityConfig: the presence of an Authorization header only exempts the
    request from CSRF tokens. Browsers cannot add that header to a cross-site request without a
    CORS preflight that the origin allow-list rejects, and a forged token fails authentication.
  -->
  <Match>
    <Class name="com.iortatechnxt.brokerverse.config.SecurityConfig"/>
    <Bug pattern="SERVLET_HEADER"/>
  </Match>
  <!--
    SERVLET_HEADER in IntegrationSecurityConfig: same rule for the gateway chain. The Authorization
    header only exempts the request from CSRF tokens; the gateway token is then verified (key set,
    issuer, audience, expiry, scopes) and a forged or missing token is refused.
  -->
  <Match>
    <Class name="com.iortatechnxt.brokerverse.config.IntegrationSecurityConfig"/>
    <Bug pattern="SERVLET_HEADER"/>
  </Match>
  <!--
    SERVLET_HEADER in CorrelationIdFilter: X-Correlation-Id is only a log / event correlation label.
    It is used only when it matches [A-Za-z0-9_-]{1,64} (otherwise a new UUID is generated), carries
    no authority and is never used in a query or a file name.
  -->
  <Match>
    <Class name="com.iortatechnxt.brokerverse.events.service.CorrelationIdFilter"/>
    <Bug pattern="SERVLET_HEADER"/>
  </Match>
  <!--
    PATH_TRAVERSAL_IN / PATH_TRAVERSAL_OUT in LocalFileStore (developer, test and seed stacks only;
    refused in production): object keys are validated by ObjectRef ([a-z0-9/_.-], no "..", no empty
    segment) and every resolved path is normalised and checked to stay under the configured root.
  -->
  <Match>
    <Class name="com.iortatechnxt.brokerverse.common.storage.LocalFileStore"/>
    <Bug pattern="PATH_TRAVERSAL_IN,PATH_TRAVERSAL_OUT"/>
  </Match>
  <!-- Generated/test code is not part of the production artefact. -->
  <Match>
    <Class name="~.*Test.*"/>
  </Match>
</FindBugsFilter>
