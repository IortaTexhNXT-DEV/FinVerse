// BRD-2: workflow OPS_RECON (V775; PRCID.001-039). FRS section 5. Stage owner in the second line.
// Solid = main path, dashed = return or optional path, dotted = closes the case.
digraph wf_recon {
  graph [rankdir=TB, fontname="Arial", nodesep=0.35, ranksep=0.3, bgcolor="white", pad=0.1];
  node  [shape=box, style="rounded,filled", fillcolor="@BG_BLUE", color="@HEADER_BLUE", penwidth=1.1,
         fontname="Arial", fontsize=12, fontcolor="@NEAR_BLACK", width=2.4, height=0.45, margin="0.08,0.02"];
  edge  [color="@MUTED", arrowsize=0.6, fontname="Arial", fontsize=10.5, fontcolor="@TEXT"];

  EXTRACTED [label="EXTRACTED\nRecon handler (RECON_SEND)"];
  SENT_TO_INSURER [label="SENT_TO_INSURER\nRecon handler (RECON_PROCESS)"];
  RECONCILING [label="RECONCILING\nRecon handler (RECON_PROCESS)"];
  CLOSED [label="CLOSED", fillcolor="@SUCCESS_BG", color="@SUCCESS"];

  EXTRACTED -> SENT_TO_INSURER [label=" send"];
  SENT_TO_INSURER -> SENT_TO_INSURER [label=" resend", style=dashed];
  SENT_TO_INSURER -> RECONCILING [label=" feedback_uploaded"];
  EXTRACTED -> RECONCILING [label=" feedback_uploaded", style=dashed];
  RECONCILING -> RECONCILING [label=" feedback_uploaded,\nresend", style=dashed];
  RECONCILING -> CLOSED [label=" close / for_closure"];
}
