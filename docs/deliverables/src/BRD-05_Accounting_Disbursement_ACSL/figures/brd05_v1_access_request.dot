// BRD-5 Volume 1: access request statuses (nbadmin, V792). FRS section 5.4; BASAU 2.3.x-2.6.x.
digraph acc_access {
  graph [rankdir=TB, fontname="Arial", nodesep=0.9, ranksep=0.6, bgcolor="white", pad=0.15];
  node  [shape=box, style="rounded,filled", fillcolor="@BG_BLUE", color="@HEADER_BLUE", penwidth=1.1,
         fontname="Arial", fontsize=13, fontcolor="@NEAR_BLACK", width=2.2, height=0.6];
  edge  [color="@MUTED", arrowsize=0.7, fontname="Arial", fontsize=11, fontcolor="@TEXT"];

  PENDING  [label="PENDING\nrequester submitted"];
  RETURNED [label="RETURNED\n(remarks)", fillcolor="@AMBER_BG"];
  APPROVED [label="APPROVED\napplied", fillcolor="@SUCCESS_BG", color="@SUCCESS"];
  REJECTED [label="REJECTED\n(reason)", fillcolor="@DIRTY_WHITE", color="@MUTED"];

  PENDING -> RETURNED [label=" return", style=dashed];
  RETURNED -> PENDING [label=" resubmit\n (requester)", style=dashed];
  PENDING -> APPROVED [label=" approve"];
  PENDING -> REJECTED [label=" decline"];
  { rank=same; PENDING; RETURNED; }
  { rank=same; APPROVED; REJECTED; }
}
