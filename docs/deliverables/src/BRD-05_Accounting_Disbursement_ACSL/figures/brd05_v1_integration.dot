// BRD-5 Volume 1: interfaces of Accounting (FRS section 7). Dashed grey = external or parked.
digraph acc_integration {
  graph [rankdir=TB, fontname="Arial", nodesep=0.6, ranksep=0.6, bgcolor="white", pad=0.15];
  node  [shape=box, style="rounded,filled", fillcolor="@WHITE", color="@HEADER_BLUE", penwidth=1.1,
         fontname="Arial", fontsize=13, fontcolor="@NEAR_BLACK", width=2.6, height=0.75];
  edge  [color="@MUTED", arrowsize=0.7, fontname="Arial", fontsize=11, fontcolor="@TEXT"];

  mods [label="Business modules\nbooking, Operations, Collections,\nDisbursement, Payment Requests, ACSL"];
  bank [label="Bank files\n(XLSX, ODS, CSV)"];
  gl   [label="General ledger\naccounting engine, journals,\nclosing, schedules, tax", fillcolor="@HEADER_BLUE", fontcolor="@WHITE", width=3.4];
  fee  [label="Service fee (FRBS)", fillcolor="@HEADER_BLUE", fontcolor="@WHITE"];
  disb [label="Disbursement\n(payouts)"];
  rep  [label="Report archive\nand batches"];
  bir  [label="BIR filing,\nBDO Unibank GARD", color="@MUTED", fontcolor="@MUTED", style="rounded,dashed"];

  { rank=same; mods; bank; }
  { rank=same; fee; rep; }
  { rank=same; disb; bir; }
  mods -> gl [label=" business events"];
  bank -> gl [label=" statements"];
  gl -> fee [label=" accrual", dir=back];
  gl -> rep;
  fee -> disb [label=" SERVICE_FEE /\n status", dir=both];
  rep -> bir [style=dashed, color="@MUTED"];
}
