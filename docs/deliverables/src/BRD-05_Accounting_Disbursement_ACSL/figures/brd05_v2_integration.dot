// BRD-5 Volume 2: interfaces of Disbursement, Payment Requests and ACSL (FRS section 7). Dashed grey = external.
digraph v2_integration {
  graph [rankdir=TB, fontname="Arial", nodesep=0.45, ranksep=0.6, bgcolor="white", pad=0.15];
  node  [shape=box, style="rounded,filled", fillcolor="@WHITE", color="@HEADER_BLUE", penwidth=1.1,
         fontname="Arial", fontsize=13, fontcolor="@NEAR_BLACK", width=2.4, height=0.7];
  edge  [color="@MUTED", arrowsize=0.7, fontname="Arial", fontsize=11, fontcolor="@TEXT"];

  mods [label="Source modules\nremittance, cashiering,\ncommission, FRBS"];
  prq  [label="Payment Requests\n(Marketing, HR)"];
  disb [label="Disbursement\nrequests, DVs,\ninstruments, EOD", fillcolor="@HEADER_BLUE", fontcolor="@WHITE", width=3];
  gl   [label="General ledger\n(accounting engine)"];
  acsl [label="ACSL\ncases, corrections,\nSOA, GL-SL", fillcolor="@HEADER_BLUE", fontcolor="@WHITE"];
  bank [label="Bank channels\nTPD (DCTF), branches, BOB", color="@MUTED", fontcolor="@MUTED", style="rounded,dashed"];
  ins  [label="Insurer SOA files", color="@MUTED", fontcolor="@MUTED", style="rounded,dashed"];

  { rank=same; mods; prq; }
  { rank=same; disb; acsl; }
  { rank=same; bank; gl; ins; }
  mods -> disb [label=" payment requests /\n status", dir=both];
  prq -> disb [label=" refunds, advances /\n status", dir=both];
  prq -> acsl [label=" validations"];
  disb -> gl [label=" DV, check, funding"];
  acsl -> gl [label=" corrections"];
  disb -> bank [label=" files, forms /\n uploads", dir=both, style=dashed, color="@MUTED"];
  ins -> acsl [label=" SOA upload", style=dashed, color="@MUTED"];
}
