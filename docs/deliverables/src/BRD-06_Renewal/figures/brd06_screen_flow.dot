digraph flow {
  graph [rankdir=TB, fontname="Arial", nodesep=0.2, ranksep=0.35, bgcolor="white", newrank=true, compound=true];
  node [shape=box, style="rounded,filled", fillcolor="@BG_BLUE", color="@HEADER_BLUE", fontname="Arial", fontsize=10, fontcolor="@NEAR_BLACK", margin="0.12,0.06"];
  edge [color="@CTA_BLUE", fontname="Arial", fontsize=8, fontcolor="@MUTED", arrowsize=0.6];
  subgraph "cluster_Home, expiry list and the renewal record" { label="Home, expiry list and the renewal record"; fontname="Arial"; fontsize=10; fontcolor="@HEADER_BLUE"; color="@BORDER"; style="rounded";
    "SCR-RN-01" [label="Renewal Home\nSCR-RN-01"];
    "SCR-RN-02" [label="Expiry List\nSCR-RN-02"];
    "SCR-RN-03" [label="Renewal\nSCR-RN-03"];
    "SCR-RN-04" [label="Renewal: Checks, Account History and Computations\nSCR-RN-04"];
    "SCR-RN-05" [label="Renewal: Insurer, Letters, Documents, Remarks and History\nSCR-RN-05"];
  }
  subgraph "cluster_Marketing: disposition, review and transfers" { label="Marketing: disposition, review and transfers"; fontname="Arial"; fontsize=10; fontcolor="@HEADER_BLUE"; color="@BORDER"; style="rounded";
    "SCR-RN-06" [label="My Dispositions\nSCR-RN-06"];
    "SCR-RN-07" [label="Set Disposition, Add Remark and Re-open\nSCR-RN-07"];
    "SCR-RN-08" [label="TL Review\nSCR-RN-08"];
    "SCR-RN-09" [label="Transfers\nSCR-RN-09"];
  }
  subgraph "cluster_Processing and the insurer" { label="Processing and the insurer"; fontname="Arial"; fontsize=10; fontcolor="@HEADER_BLUE"; color="@BORDER"; style="rounded";
    "SCR-RN-10" [label="Processing Worklist\nSCR-RN-10"];
    "SCR-RN-11" [label="Insurer Batches\nSCR-RN-11"];
    "SCR-RN-12" [label="Record Insurer Response\nSCR-RN-12"];
  }
  subgraph "cluster_Letters, acceptance and follow-up" { label="Letters, acceptance and follow-up"; fontname="Arial"; fontsize=10; fontcolor="@HEADER_BLUE"; color="@BORDER"; style="rounded";
    "SCR-RN-13" [label="Letters\nSCR-RN-13"];
    "SCR-RN-14" [label="Record Acceptance\nSCR-RN-14"];
    "SCR-RN-15" [label="Follow-ups\nSCR-RN-15"];
    "SCR-RN-16" [label="LAMD Reports\nSCR-RN-16"];
  }
  subgraph "cluster_Renewal Setup" { label="Renewal Setup"; fontname="Arial"; fontsize=10; fontcolor="@HEADER_BLUE"; color="@BORDER"; style="rounded";
    "SCR-RN-17" [label="Renewal Setup: Non-renewable Risk Codes and Checks\nSCR-RN-17"];
    "SCR-RN-18" [label="Renewal Setup: Classification Rules and Decision Matrix\nSCR-RN-18"];
    "SCR-RN-19" [label="Renewal Setup: Package Map, Package Choices and Propose Package\nSCR-RN-19"];
    "SCR-RN-20" [label="Renewal Setup: Go-live\nSCR-RN-20"];
  }
  "SCR-RN-01" -> "SCR-RN-02" [label="tiles and statuses"];
  "SCR-RN-02" -> "SCR-RN-03" [label="open"];
  "SCR-RN-02" -> "SCR-RN-09" [label="Transfer"];
  "SCR-RN-06" -> "SCR-RN-03" [label="open"];
  "SCR-RN-03" -> "SCR-RN-04" [label="Checks, Account History"];
  "SCR-RN-04" -> "SCR-RN-07" [label="Set Disposition"];
  "SCR-RN-07" -> "SCR-RN-08" [label="Push"];
  "SCR-RN-08" -> "SCR-RN-10" [label="Post (For Renewal)"];
  "SCR-RN-08" -> "SCR-RN-13" [label="Post (Not for Renewal)"];
  "SCR-RN-08" -> "SCR-RN-06" [label="Return"];
  "SCR-RN-10" -> "SCR-RN-11" [label="New Batch"];
  "SCR-RN-11" -> "SCR-RN-12" [label="insurer reply"];
  "SCR-RN-12" -> "SCR-RN-13" [label="RA Ready"];
  "SCR-RN-13" -> "SCR-RN-15" [label="RA Sent"];
  "SCR-RN-15" -> "SCR-RN-14" [label="Record Acceptance"];
  "SCR-RN-14" -> "SCR-RN-05" [label="Letters tab"];
  "SCR-RN-16" -> "SCR-RN-08" [label="past-due loan"];
  "SCR-RN-17" -> "SCR-RN-02" [label="checks on Initiate"];
  "SCR-RN-18" -> "SCR-RN-04" [label="classification"];
  "SCR-RN-19" -> "SCR-RN-03" [label="package choice"];
  "SCR-RN-20" -> "SCR-RN-02" [label="go-live renewals"];
}
