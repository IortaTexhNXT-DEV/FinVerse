// BRD-6: workflow RNW_CASE, part 1 (extraction to posting). FRS section 5. Stage owner in the second line.
digraph rn_workflow_mkt {
  graph [rankdir=TB, fontname="Arial", nodesep=0.5, ranksep=0.42, bgcolor="white", pad=0.1];
  node  [shape=box, style="rounded,filled", fillcolor="@BG_BLUE", color="@HEADER_BLUE", penwidth=1.1,
         fontname="Arial", fontsize=14, fontcolor="@NEAR_BLACK", width=2.6, height=0.55, margin="0.1,0.03"];
  edge  [color="@MUTED", arrowsize=0.7, fontname="Arial", fontsize=12, fontcolor="@TEXT"];

  EXTRACTED        [label="EXTRACTED\nSystem / TL (range)", fillcolor="@DIRTY_WHITE"];
  EVALUATING       [label="EVALUATING\nchecks, bucket, matrix", fillcolor="@DIRTY_WHITE"];
  UNASSIGNED       [label="UNASSIGNED\nMarketing TL"];
  TRANSFER_PENDING [label="TRANSFER_PENDING\nReceiving TL"];
  FOR_DISPOSITION  [label="FOR_DISPOSITION\nMarketing AO"];
  FOR_TL_REVIEW    [label="FOR_TL_REVIEW\nMarketing TL"];
  FOR_PROCESSING   [label="FOR_PROCESSING\n(part 2)", fillcolor="@SUCCESS_BG", color="@SUCCESS"];
  NB_PATH          [label="NB_PATH\nquotation / PRF", fillcolor="@SUCCESS_BG", color="@SUCCESS"];
  LETTER_PENDING   [label="LETTER_PENDING\nNFR / NAL (part 2)", fillcolor="@SUCCESS_BG", color="@SUCCESS"];
  CLOSED           [label="CLOSED (LOST)", fillcolor="@DIRTY_WHITE", color="@MUTED"];

  EXTRACTED -> EVALUATING [label=" initiate"];
  EVALUATING -> UNASSIGNED [label=" non-CBG; MANUAL\n or not CLEAN"];
  EVALUATING -> FOR_TL_REVIEW [label=" CLEAN + AUTO", style=dashed];
  UNASSIGNED -> FOR_DISPOSITION [label=" assign"];
  UNASSIGNED -> TRANSFER_PENDING [label=" transfer", style=dashed];
  TRANSFER_PENDING -> UNASSIGNED [label=" accept /\n decline", style=dashed, constraint=false];
  FOR_DISPOSITION -> FOR_TL_REVIEW [label=" dispose + push"];
  FOR_TL_REVIEW -> FOR_DISPOSITION [label=" return", style=dashed, constraint=false];
  FOR_TL_REVIEW -> FOR_PROCESSING [label=" post: For Renewal"];
  FOR_TL_REVIEW -> NB_PATH [label=" post: For Quotation /\n For Proposal"];
  FOR_TL_REVIEW -> LETTER_PENDING [label=" post: Not for Renewal"];
  FOR_TL_REVIEW -> CLOSED [label=" post: Lost Business", style=dotted];

  { rank=same; UNASSIGNED; TRANSFER_PENDING; }
  { rank=same; FOR_PROCESSING; NB_PATH; }
  { rank=same; LETTER_PENDING; CLOSED; }
  FOR_PROCESSING -> LETTER_PENDING [style=invis];
}
