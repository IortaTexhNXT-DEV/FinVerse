// BRD-8 Employee Benefits: workflow EB_MEMBER_CHANGE (FRS section 5.3; BRID-013, 025).
digraph eb_member_change {
  graph [rankdir=TB, fontname="Arial", nodesep=0.8, ranksep=0.4, bgcolor="white", pad=0.1];
  node  [shape=box, style="rounded,filled", fillcolor="@BG_BLUE", color="@HEADER_BLUE", penwidth=1.1,
         fontname="Arial", fontsize=14, fontcolor="@NEAR_BLACK", width=2.6, height=0.6, margin="0.08,0.03"];
  edge  [color="@MUTED", arrowsize=0.7, fontname="Arial", fontsize=12, fontcolor="@TEXT"];

  CAPTURED  [label="CAPTURED\nAO or client HR"];
  RELAYED   [label="RELAYED\ninsurer (portal task)"];
  BILLED    [label="BILLED\ninsurer / AO (direct billing)"];
  VALIDATED [label="VALIDATED\nProcessing"];
  CLOSED    [label="CLOSED", fillcolor="@SUCCESS_BG", color="@SUCCESS"];
  CANCELLED [label="CANCELLED", fillcolor="@DIRTY_WHITE", color="@MUTED"];

  CAPTURED -> RELAYED [label="  relay"];
  RELAYED -> BILLED [label="  billing uploaded"];
  BILLED -> VALIDATED [label="  validate"];
  VALIDATED -> CLOSED [label="  close (endorsement raised\n  if financial)"];
  BILLED -> CAPTURED [label="  return (reason)", style=dashed, constraint=false];
  CAPTURED -> CANCELLED [label="  cancel", style=dotted];
  { rank=same; CAPTURED; CANCELLED; }
}
