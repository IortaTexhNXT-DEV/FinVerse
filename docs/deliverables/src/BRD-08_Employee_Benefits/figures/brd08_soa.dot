// BRD-8 Employee Benefits: workflow EB_SOA (FRS section 5.4; BRID-021).
digraph eb_soa {
  graph [rankdir=TB, fontname="Arial", nodesep=0.8, ranksep=0.45, bgcolor="white", pad=0.1];
  node  [shape=box, style="rounded,filled", fillcolor="@BG_BLUE", color="@HEADER_BLUE", penwidth=1.1,
         fontname="Arial", fontsize=14, fontcolor="@NEAR_BLACK", width=2.4, height=0.6, margin="0.08,0.03"];
  edge  [color="@MUTED", arrowsize=0.7, fontname="Arial", fontsize=12, fontcolor="@TEXT"];

  RECEIVED  [label="RECEIVED\ninsurer upload or AO"];
  VALIDATED [label="VALIDATED\nProcessing"];
  REJECTED  [label="REJECTED\n(reason)", fillcolor="@AMBER_BG"];
  RELEASED  [label="RELEASED\nclient HR, Collection", fillcolor="@SUCCESS_BG", color="@SUCCESS"];

  RECEIVED -> VALIDATED [label="  validate"];
  RECEIVED -> REJECTED [label="  reject"];
  VALIDATED -> RELEASED [label="  release"];
  { rank=same; VALIDATED; REJECTED; }
}
