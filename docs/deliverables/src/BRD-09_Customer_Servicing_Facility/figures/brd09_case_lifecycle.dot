// BRD-9 Customer Servicing Facility: case lifecycle of the Case Management Addendum (FRS section 5.3; addendum p.4-8).
digraph csf_case_lifecycle {
  graph [rankdir=TB, fontname="Arial", nodesep=0.6, ranksep=0.5, bgcolor="white", pad=0.12];
  node  [shape=box, style="rounded,filled", fillcolor="@BG_BLUE", color="@HEADER_BLUE", penwidth=1.1,
         fontname="Arial", fontsize=14, fontcolor="@NEAR_BLACK", width=2.8, height=0.7, margin="0.08,0.04"];
  edge  [color="@MUTED", arrowsize=0.7, fontname="Arial", fontsize=12, fontcolor="@TEXT"];

  LOG   [label="Agent logs the case\nCase ID, type and TAT, due date", fillcolor="@WHITE"];
  WFU   [label="Open - With\nFulfillment Unit"];
  RET   [label="Open - Returned\nto Agent", fillcolor="@AMBER_BG"];
  CSR   [label="Open - CSR\nAction Required", fillcolor="@AMBER_BG"];
  CFU   [label="Closed by\nFulfillment Unit", fillcolor="@SUCCESS_BG", color="@SUCCESS"];
  CCSR  [label="Closed by CSR", fillcolor="@SUCCESS_BG", color="@SUCCESS"];
  FUP   [label="Follow-up case\n(new Case ID, linked)", fillcolor="@DIRTY_WHITE", color="@MUTED", style="rounded,dashed,filled"];

  LOG -> WFU  [label="  Submit to Fulfilment Unit"];
  LOG -> CCSR [label="  Resolve and Close"];
  WFU -> CFU  [label="  Resolve and Close (FU)"];
  WFU -> RET  [label="  Return to Agent (FU)"];
  WFU -> CSR  [label="  Request CSR Action (FU)"];
  RET -> WFU  [label="  Re-endorse"];
  RET -> CCSR [label="  Close (agent)"];
  CSR -> CCSR [label="  Close (agent)"];
  CFU -> FUP  [style=dashed, label="  item pending"];
  CCSR -> FUP [style=dashed];
  { rank=same; RET; CSR; }
  { rank=same; CFU; CCSR; }
}
