// BRD-9 Customer Servicing Facility: verification, contact change and legacy sync states (FRS section 5).
digraph csf_contact_change {
  graph [rankdir=TB, fontname="Arial", nodesep=0.7, ranksep=0.45, bgcolor="white", pad=0.1];
  node  [shape=box, style="rounded,filled", fillcolor="@BG_BLUE", color="@HEADER_BLUE", penwidth=1.1,
         fontname="Arial", fontsize=14, fontcolor="@NEAR_BLACK", width=2.6, height=0.6, margin="0.08,0.03"];
  edge  [color="@MUTED", arrowsize=0.7, fontname="Arial", fontsize=12, fontcolor="@TEXT"];

  VER     [label="Verification\nchecklist"];
  PASSED  [label="PASSED\nvalid 30 minutes"];
  FAILED  [label="FAILED\nno change allowed", fillcolor="@AMBER_BG"];
  APPLIED [label="Change APPLIED\nclient master updated", fillcolor="@SUCCESS_BG", color="@SUCCESS"];
  REFUSED [label="Change REFUSED\n(field not updatable)", fillcolor="@DIRTY_WHITE", color="@MUTED"];
  NOTCFG  [label="Sync NOT_CONFIGURED\n(outbox, CSQ01)", fillcolor="@DIRTY_WHITE", color="@MUTED", style="rounded,dashed,filled"];
  QUEUED  [label="Sync QUEUED"];
  SENT    [label="Sync SENT", fillcolor="@SUCCESS_BG", color="@SUCCESS"];
  SFAIL   [label="Sync FAILED\n(alert, retry)", fillcolor="@AMBER_BG"];

  VER -> PASSED [label="  enough checks match"];
  VER -> FAILED [label="  too few match"];
  PASSED -> APPLIED [label="  save contact"];
  PASSED -> REFUSED [label="  other field", style=dotted];
  APPLIED -> NOTCFG [label="  sync disabled"];
  APPLIED -> QUEUED [label="  sync enabled"];
  QUEUED -> SENT; QUEUED -> SFAIL;
  SFAIL -> QUEUED [label="  retry", style=dashed, constraint=false];
  { rank=same; PASSED; FAILED; }
  { rank=same; APPLIED; REFUSED; }
  { rank=same; NOTCFG; QUEUED; }
}
