// BRD-11: status of a group-profile request (types CREATE_ROLE, MODIFY_ROLE_PERMISSIONS, DEACTIVATE_ROLE, REACTIVATE_ROLE). FRS section 5.2.
digraph ua_group {
  graph [rankdir=TB, fontname="Arial", nodesep=0.55, ranksep=0.35, bgcolor="white", pad=0.1];
  node  [shape=box, style="rounded,filled", fillcolor="@BG_BLUE", color="@HEADER_BLUE", penwidth=1.1,
         fontname="Arial", fontsize=12, fontcolor="@NEAR_BLACK", width=2.5, height=0.5, margin="0.08,0.02"];
  edge  [color="@MUTED", arrowsize=0.6, fontname="Arial", fontsize=10.5, fontcolor="@TEXT"];

  DRAFT       [label="DRAFT\nBusiness Administrator"];
  PENDING     [label="PENDING\nApprover n of N (in order)"];
  RETURNED    [label="RETURNED\nBusiness Administrator", fillcolor="@AMBER_BG"];
  FOR_IMPL    [label="FOR_IMPLEMENTATION\nSystem Administrator"];
  IMPLEMENTED [label="IMPLEMENTED\n(role changed)", fillcolor="@SUCCESS_BG", color="@SUCCESS"];
  REJECTED    [label="REJECTED", fillcolor="@DIRTY_WHITE", color="@MUTED"];
  CANCELLED   [label="CANCELLED", fillcolor="@DIRTY_WHITE", color="@MUTED"];

  DRAFT -> PENDING [label=" submit", weight=10];
  PENDING -> PENDING [label=" approve (next\n approver)", headport=ne, tailport=se];
  PENDING -> FOR_IMPL [label=" approve\n (last approver)", weight=10];
  FOR_IMPL -> IMPLEMENTED [label=" implement", weight=10];
  PENDING -> RETURNED [label=" return", style=dashed];
  RETURNED -> PENDING [label=" re-submit", style=dashed, constraint=false];
  PENDING -> REJECTED [label=" reject (any approver)", style=dotted];
  DRAFT -> CANCELLED [label=" cancel", style=dotted];

  { rank=same; FOR_IMPL; RETURNED; }
  { rank=same; DRAFT; CANCELLED; }
  { rank=same; IMPLEMENTED; REJECTED; }
}
