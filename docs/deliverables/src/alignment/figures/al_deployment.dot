// BIBS infrastructure and deployment per the IER (for the IER "Architecture Diagram (Infra)" sheet and section 6).
digraph al_deployment {
  graph [rankdir=LR, fontname="Arial", nodesep=0.18, ranksep=0.4, bgcolor="white", pad=0.2, newrank=true, compound=true,
         label=<<font point-size="16" color="@HEADER_BLUE"><b>BIBS - infrastructure and deployment (production)</b></font><br/><font point-size="10" color="@MUTED">AWS ap-southeast-1, three Availability Zones. DEV, SIT, UAT: same layout, Single-AZ RDS, 2-broker MSK, 12 x 5. Pre-Prod: production-sized. DR region to be confirmed (IQ26).</font>>,
         labelloc=t, labeljust=l];
  node  [shape=box, style="rounded,filled", color="@HEADER_BLUE", penwidth=1.0, fontname="Arial",
         fontsize=10, fontcolor="@NEAR_BLACK", margin="0.1,0.05", fillcolor="@WHITE"];
  edge  [color="@HEADER_BLUE", arrowsize=0.6, penwidth=1.1, fontname="Arial", fontsize=8, fontcolor="@MUTED"];

  users [label=<<b>BDOI users</b><br/><font point-size="9">BDO network / VPN</font>>, fillcolor="@BG_BLUE"];
  ops_  [label=<<b>Support and delivery</b><br/><font point-size="9">VDI (15 users), bastion via SSM,<br/>CI/CD runner, ECR images</font>>, fillcolor="@DIRTY_WHITE"];

  subgraph cluster_region {
    label=<<b>AWS ap-southeast-1 - production VPC</b>>; fontsize=12; fontcolor="@HEADER_BLUE"; style="rounded"; color="@HEADER_BLUE"; margin=10;
    subgraph cluster_pub {
      label=<<b>Public / edge subnets</b>>; fontsize=10; style="rounded,dashed"; color="@MUTED"; margin=6;
      r53 [label=<<b>Route 53</b><br/><font point-size="9">private or public zone</font>>];
      alb [label=<<b>AWS WAF + ALB</b><br/><font point-size="9">TLS, AWS Load Balancer Controller</font>>];
      r53 -> alb;
    }
    subgraph cluster_app {
      label=<<b>Private application subnets - Amazon EKS</b>>; fontsize=10; style="rounded,dashed"; color="@MUTED"; margin=6;
      ng [label=<<b>Managed node group</b><br/><font point-size="9">m5.2xlarge class, 3 AZs,<br/>cluster autoscaler</font>>, fillcolor="@DIRTY_WHITE"];
      fe [label=<<b>brokerverse-frontend</b><br/><font point-size="9">2-4 pods (nginx)</font>>, fillcolor="@BG_BLUE"];
      be [label=<<b>brokerverse-backend</b><br/><font point-size="9">3-6 pods, HPA, PDB min 2;<br/>jobs run once per schedule<br/>(Redis job lock)</font>>, fillcolor="@BG_BLUE"];
      agents [label=<<b>Cluster agents</b><br/><font point-size="9">monitoring agent, EDR agent,<br/>metrics server</font>>, fillcolor="@DIRTY_WHITE"];
      fe -> be [label="/api"];
    }
    subgraph cluster_db {
      label=<<b>Private data subnets</b>>; fontsize=10; style="rounded,dashed"; color="@MUTED"; margin=6;
      rds [label=<<b>RDS PostgreSQL 16 Multi-AZ</b><br/><font point-size="9">primary + standby, PITR,<br/>KMS encryption, 2 TB (IER)</font>>, fillcolor="@SUCCESS_BG", color="@SUCCESS"];
      redis [label=<<b>ElastiCache Redis 7</b><br/><font point-size="9">cluster mode disabled,<br/>primary + replica, TLS, AUTH</font>>, fillcolor="@SUCCESS_BG", color="@SUCCESS"];
      msk [label=<<b>Amazon MSK</b><br/><font point-size="9">3 brokers in 3 AZs,<br/>SASL/SCRAM, TLS</font>>, fillcolor="@SUCCESS_BG", color="@SUCCESS"];
    }
    subgraph cluster_reg {
      label=<<b>Regional services (VPC endpoints)</b>>; fontsize=10; style="rounded,dashed"; color="@MUTED"; margin=6;
      s3 [label=<<b>Amazon S3</b><br/><font point-size="9">bibs-documents (versioned, lifecycle),<br/>bibs-migration-intake (5-day purge),<br/>logs; SSE-KMS</font>>, fillcolor="@AMBER_BG"];
      sec [label=<<b>Secrets Manager, KMS</b><br/><font point-size="9">DB, Redis, MSK secrets;<br/>customer-managed keys</font>>, fillcolor="@DIRTY_WHITE"];
      mon [label=<<b>Monitoring and logs</b><br/><font point-size="9">CloudWatch and the BDO APM<br/>(Dynatrace or Prometheus, IQ30)</font>>, fillcolor="@DIRTY_WHITE"];
    }
  }

  subgraph cluster_dr {
    label=<<b>DR (region to confirm)</b>>; fontsize=12; fontcolor="@HEADER_BLUE"; style="rounded,dashed"; color="@DANGER"; margin=10;
    dr_rds [label=<<b>RDS read replica</b><br/><font point-size="9">async, RPO &lt;= 15 min</font>>, fillcolor="@WHITE"];
    dr_s3 [label=<<b>S3 replica</b><br/><font point-size="9">cross-region replication</font>>, fillcolor="@WHITE"];
    dr_eks [label=<<b>EKS standby</b><br/><font point-size="9">0 pods until failover;<br/>Redis, MSK rebuilt; RTO 4 h</font>>, fillcolor="@WHITE"];
  }

  users -> r53 [label="HTTPS"];
  alb -> fe;
  be -> rds [label="JDBC"];
  be -> redis;
  be -> msk;
  be -> s3 [label="IRSA"];
  be -> sec [style=dashed];
  be -> mon [style=dashed];
  ops_ -> ng [style=dashed, label="deploy"];
  rds -> dr_rds [style=dashed, color="@DANGER", label="replication"];
  s3 -> dr_s3 [style=dashed, color="@DANGER"];
  ng -> dr_eks [style=invis];
}
