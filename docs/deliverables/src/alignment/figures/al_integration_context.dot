// Programme alignment: BIBS and the BDO / BDOI systems it exchanges data with (drop, direction, BIBS seam).
digraph al_integration_context {
  graph [rankdir=LR, fontname="Arial", nodesep=0.14, ranksep=0.9, bgcolor="white", pad=0.12, newrank=true];
  node  [shape=box, style="rounded,filled", color="@HEADER_BLUE", penwidth=1.0, fontname="Arial",
         fontsize=10, fontcolor="@NEAR_BLACK", width=2.5, height=0.42, margin="0.08,0.03", fillcolor="@WHITE"];
  edge  [color="@HEADER_BLUE", arrowsize=0.6, penwidth=1.0, fontname="Arial", fontsize=8, fontcolor="@MUTED"];

  subgraph cluster_left {
    label=<<b>Identity, communication, content (Drop 0)</b>>; fontsize=11; fontcolor="@HEADER_BLUE"; style="rounded,dashed"; color="@MUTED"; margin=8;
    eiam [label=<<b>EIAM</b> (Entra ID)<br/><font point-size="8">sign-in, OIDC</font>>, fillcolor="@AMBER_BG"];
    isc  [label=<<b>UIDM-ISC</b> (IGA)<br/><font point-size="8">provisioning, aggregation</font>>, fillcolor="@AMBER_BG"];
    ccm  [label=<<b>CCM</b><br/><font point-size="8">e-mail sending</font>>, fillcolor="@BG_BLUE"];
    m365 [label=<<b>M365 Exchange</b><br/><font point-size="8">mailboxes (role to confirm)</font>>, fillcolor="@DIRTY_WHITE"];
    ecm  [label=<<b>ECM</b><br/><font point-size="8">no document storage (S3 only)</font>>, fillcolor="@DIRTY_WHITE", color="@MUTED"];
    s3   [label=<<b>Amazon S3</b><br/><font point-size="8">documents and files (answer A4)</font>>, fillcolor="@SUCCESS_BG", color="@SUCCESS"];
  }
  subgraph cluster_bank {
    label=<<b>Bank and loan systems (Drop 0)</b>>; fontsize=11; fontcolor="@HEADER_BLUE"; style="rounded,dashed"; color="@MUTED"; margin=8;
    cms  [label=<<b>CMS / New BOB</b><br/><font point-size="8">outward payments</font>>, fillcolor="@AMBER_BG"];
    obp  [label=<<b>OBPCS</b><br/><font point-size="8">bills payment</font>>, fillcolor="@BG_BLUE"];
    obob [label=<<b>Old BOB</b><br/><font point-size="8">SOA funds transfers</font>>, fillcolor="@BG_BLUE"];
    afts [label=<<b>AFTS</b><br/><font point-size="8">purpose to confirm</font>>, fillcolor="@DIRTY_WHITE"];
    pms  [label=<<b>PMS</b><br/><font point-size="8">PDC warehouse</font>>, fillcolor="@BG_BLUE"];
    tfs  [label=<<b>TFS</b> (manual)<br/><font point-size="8">trade clients, payments</font>>, fillcolor="@SUCCESS_BG"];
    lms  [label=<<b>LMS</b><br/><font point-size="8">loan status, PN, CLPC</font>>, fillcolor="@AMBER_BG"];
    hls  [label=<<b>HL-LOAS</b> (HLS / LOAS)<br/><font point-size="8">quotation requests, HLS report</font>>, fillcolor="@AMBER_BG"];
    lfs  [label=<<b>LFS SaaS</b><br/><font point-size="8">submitted policies</font>>, fillcolor="@AMBER_BG"];
  }

  bibs [label=<<b>BIBS</b><br/><font point-size="9">BDOI Broker System<br/>(iNXT BrokerVerse)</font>>, shape=box, style="rounded,filled,bold", fillcolor="@HEADER_BLUE", fontcolor="@WHITE", fontsize=13, width=1.9, height=1.3];

  subgraph cluster_right {
    label=<<b>Enterprise and external (Drop 2)</b>>; fontsize=11; fontcolor="@HEADER_BLUE"; style="rounded,dashed"; color="@MUTED"; margin=8;
    edp  [label=<<b>EDP</b> data ingestion (SD 11)<br/><font point-size="8">analytics feed</font>>, fillcolor="@AMBER_BG"];
    egl  [label=<<b>EGL</b><br/><font point-size="8">enterprise general ledger</font>>, fillcolor="@AMBER_BG"];
    carms [label=<<b>CARMS</b><br/><font point-size="8">to confirm</font>>, fillcolor="@DIRTY_WHITE"];
    ins  [label=<<b>Insurer systems</b><br/><font point-size="8">production, OR, SOA, renewal</font>>, fillcolor="@AMBER_BG"];
    brg  [label=<<b>Bridger Insight XG</b> (manual)<br/><font point-size="8">name screening</font>>, fillcolor="@SUCCESS_BG"];
    leg  [label=<<b>Legacy EBIX, QPS, ISYS</b><br/><font point-size="8">migration extracts only</font>>, fillcolor="@DIRTY_WHITE"];
  }

  eiam -> bibs [dir=both, label="tokens"];
  isc -> bibs [dir=both, label="accounts"];
  bibs -> ccm [label="e-mail"];
  m365 -> bibs [style=dashed];
  ecm -> bibs [style=dotted, arrowhead=none];
  bibs -> s3 [dir=both, label="objects"];
  bibs -> cms [label="payments, status", dir=both];
  obp -> bibs [label="collections"];
  obob -> bibs;
  afts -> bibs [style=dashed];
  pms -> bibs [label="PDC list"];
  tfs -> bibs [style=dashed, label="manual"];
  lms -> bibs;
  hls -> bibs;
  lfs -> bibs;
  bibs -> edp [label="extracts"];
  bibs -> egl [label="GL"];
  bibs -> carms [style=dashed, dir=both];
  bibs -> ins [dir=both];
  brg -> bibs [style=dashed, label="manual"];
  leg -> bibs [label="migration"];
}
