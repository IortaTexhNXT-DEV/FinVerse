// BRD-1: workflow NB_CLIENT (V801), client onboarding. FRS section 5.1; BRNB.090, 101.
digraph nb_client {
  graph [rankdir=TB, fontname="Arial", nodesep=0.5, ranksep=0.4, bgcolor="white", pad=0.15];
  node  [shape=box, style="rounded,filled", fillcolor="@BG_BLUE", color="@HEADER_BLUE", penwidth=1.1,
         fontname="Arial", fontsize=12, fontcolor="@NEAR_BLACK", width=2.4, height=0.5, margin="0.08,0.03"];
  edge  [color="@MUTED", arrowsize=0.6, fontname="Arial", fontsize=10.5, fontcolor="@TEXT"];

  PROSPECT     [label="PROSPECT (PR code)\nMarketing AO"];
  KYC_REVIEW   [label="KYC_REVIEW\nVerifier (not the maker)"];
  KYC_VERIFIED [label="KYC_VERIFIED\nMarketing"];
  CONFIRMED    [label="CONFIRMED (CL code)", fillcolor="@SUCCESS_BG", color="@SUCCESS"];
  INACTIVE     [label="INACTIVE", fillcolor="@DIRTY_WHITE", color="@MUTED"];

  PROSPECT -> KYC_REVIEW [label=" submit_kyc\n (documents, minimum data)"];
  KYC_REVIEW -> KYC_VERIFIED [label=" verify_kyc"];
  KYC_REVIEW -> PROSPECT [label=" return (reason)", style=dashed, constraint=false];
  KYC_VERIFIED -> CONFIRMED [label=" confirm"];
  CONFIRMED -> CONFIRMED [label=" review_kyc\n (periodic)"];
  CONFIRMED -> INACTIVE [label=" deactivate (reason),\n from any stage", style=dotted];
}
