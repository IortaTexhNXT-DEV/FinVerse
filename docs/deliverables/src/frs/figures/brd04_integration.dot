// BRD-4: interfaces of Collections. FRS section 7 (the table gives the content of each flow).
// Dashed grey = parked seam.
digraph clx_integration {
  graph [rankdir=TB, fontname="Arial", nodesep=0.5, ranksep=0.7, bgcolor="white", pad=0.15, splines=true];
  node  [shape=box, style="rounded,filled", fillcolor="@WHITE", color="@HEADER_BLUE", penwidth=1.1,
         fontname="Arial", fontsize=13, fontcolor="@NEAR_BLACK", width=2.4, height=0.7];
  edge  [color="@MUTED", arrowsize=0.7, fontname="Arial", fontsize=11, fontcolor="@TEXT"];

  ledger [label="Invoice ledger\n(opsledger)"];
  org    [label="Sales organisation,\naccount, client"];
  legacy [label="EBIX / QPS migration\nISYS Marketing Diary", color="@MUTED", fontcolor="@MUTED", style="rounded,dashed"];

  clx [label="Collections\nworklist, dispositions, promises,\nplans, escalations, SOA", fillcolor="@HEADER_BLUE", fontcolor="@WHITE", width=3.4];
  upp [label="Collections\nunapplied payments\n(collector side)", fillcolor="@HEADER_BLUE", fontcolor="@WHITE", width=2.6];

  comm [label="Commission\nDP list, CR billing"];
  cash [label="Cashiering\npick-up, 2307, unapplied,\ncollector requests"];
  msg  [label="Messaging and alerts\n(SOA e-mails)"];
  fs04 [label="BDOI file server FS04\n(application file)", color="@MUTED", fontcolor="@MUTED", style="rounded,dashed"];

  { rank=same; ledger; org; legacy; }
  { rank=same; clx; upp; }
  { rank=same; comm; cash; }
  { rank=same; msg; fs04; }

  ledger -> clx [label=" balances"];
  org -> clx;
  legacy -> clx [style=dashed, color="@MUTED"];
  clx -> comm [label=" DP list /\n DP returned", dir=both];
  clx -> cash [label=" pick-up,\n 2307"];
  upp -> cash [label=" requests /\n decisions", dir=both];
  comm -> msg [style=invis];
  clx -> msg [constraint=false, style=dotted];
  cash -> fs04 [style=invis];
  upp -> fs04 [style=dashed, color="@MUTED", constraint=false];
}
