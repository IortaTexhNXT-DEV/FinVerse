// BRD-8 Employee Benefits: workflow EB_FRANCHISE (FRS section 5.2; BRID-026, 027, 029).
digraph eb_franchise {
  graph [rankdir=TB, fontname="Arial", nodesep=0.8, ranksep=0.45, bgcolor="white", pad=0.1];
  node  [shape=box, style="rounded,filled", fillcolor="@BG_BLUE", color="@HEADER_BLUE", penwidth=1.1,
         fontname="Arial", fontsize=14, fontcolor="@NEAR_BLACK", width=2.2, height=0.6, margin="0.08,0.03"];
  edge  [color="@MUTED", arrowsize=0.7, fontname="Arial", fontsize=12, fontcolor="@TEXT"];

  DRAFT     [label="DRAFT\nAO"];
  SUBMITTED [label="SUBMITTED\ninsurer (portal)"];
  APPROVED  [label="APPROVED", fillcolor="@SUCCESS_BG", color="@SUCCESS"];
  REJECTED  [label="REJECTED", fillcolor="@AMBER_BG"];
  EXPIRED   [label="EXPIRED\n(no reply in TAT)", fillcolor="@DIRTY_WHITE", color="@MUTED"];
  ADVISED   [label="ADVISED\nclient informed"];

  DRAFT -> SUBMITTED [label="  submit (BOR, documents)"];
  SUBMITTED -> APPROVED [label="  approve"];
  SUBMITTED -> REJECTED [label="  reject (reason)"];
  SUBMITTED -> EXPIRED [label="  job", style=dotted];
  APPROVED -> ADVISED [label="  advise client"];
  REJECTED -> ADVISED [label="  advise client"];
  { rank=same; APPROVED; REJECTED; EXPIRED; }
}
