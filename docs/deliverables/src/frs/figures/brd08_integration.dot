// BRD-8 Employee Benefits: interfaces of the eb and portal modules (FRS section 7). Dashed grey = parked seam.
// Left to right: external parties, the portal realm, the EB module, BIBS modules stacked in one column.
digraph eb_integration {
  graph [rankdir=LR, fontname="Arial", nodesep=0.18, ranksep=0.9, bgcolor="white", pad=0.15];
  node  [shape=box, style="rounded,filled", fillcolor="@WHITE", color="@HEADER_BLUE", penwidth=1.1,
         fontname="Arial", fontsize=13, fontcolor="@NEAR_BLACK", width=2.3, height=0.6];
  edge  [color="@MUTED", arrowsize=0.7, fontname="Arial", fontsize=11, fontcolor="@TEXT"];

  ins   [label="Insurer users\n(internet)"];
  hr    [label="Client HR users\n(internet)"];
  api   [label="Insurer systems\n(API, EBQ13)", color="@MUTED", fontcolor="@MUTED", style="rounded,dashed"];

  subgraph cluster_bibs {
    label="BIBS"; labeljust=l; fontcolor="@HEADER_BLUE"; fontsize=13;
    style=filled; fillcolor="@BG_BLUE"; color="@BG_BLUE";
    ptl [label="Partner portal\n(separate realm,\n/api/portal)", fillcolor="@HEADER_BLUE", fontcolor="@WHITE", height=1.1];
    eb  [label="Employee Benefits\n(eb)", fillcolor="@HEADER_BLUE", fontcolor="@WHITE", height=1.1];
    { rank=same; ptl; eb; }
  }

  uam   [label="User Access (BRD-11)\nEXTERNAL requests"];
  crm   [label="Client master (CRM)"];
  acc   [label="Accounts, placement,\nissuance, booking (BRD-1)"];
  adj   [label="Endorsement requests\n(BRD-2 adjustment)"];
  led   [label="Invoice ledger\n(BRD-2 opsledger)"];
  doc   [label="Documents, access classes,\nRENEWAL_ADVICE"];
  mail  [label="E-mail outbox\n(protected files)"];
  rpt   [label="Reports (DOCX export)"];
  rnw   [label="Renewal (BRD-6), CSF (BRD-9)"];

  ins -> ptl; hr -> ptl;
  api -> ptl [style=dashed, color="@MUTED"];
  ptl -> eb [label="staged uploads,\ntasks"];
  ptl -> uam [label="provision users", dir=back];
  eb -> crm [label="client, prospect"];
  eb -> acc [label="accounts from the\nchosen proposal"];
  eb -> adj [label="financial member\nchanges"];
  eb -> led [label="payment status", dir=back];
  eb -> doc;
  eb -> mail;
  eb -> rpt;
  eb -> rnw [label="RAs (documents)"];
}
