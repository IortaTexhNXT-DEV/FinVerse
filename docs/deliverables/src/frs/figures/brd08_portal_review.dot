// BRD-8 Employee Benefits: workflow PORTAL_UPLOAD_REVIEW (FRS section 5.5; BRID-005.01, 005.03, 014).
digraph eb_portal_review {
  graph [rankdir=TB, fontname="Arial", nodesep=0.8, ranksep=0.45, bgcolor="white", pad=0.1];
  node  [shape=box, style="rounded,filled", fillcolor="@BG_BLUE", color="@HEADER_BLUE", penwidth=1.1,
         fontname="Arial", fontsize=14, fontcolor="@NEAR_BLACK", width=2.6, height=0.6, margin="0.08,0.03"];
  edge  [color="@MUTED", arrowsize=0.7, fontname="Arial", fontsize=12, fontcolor="@TEXT"];

  RECEIVED  [label="RECEIVED\nstaged, virus scan"];
  VALIDATED [label="VALIDATED\nattachment or data created", fillcolor="@SUCCESS_BG", color="@SUCCESS"];
  REJECTED  [label="REJECTED\nportal user told why", fillcolor="@AMBER_BG"];

  RECEIVED -> RECEIVED [label="  re-map target"];
  RECEIVED -> VALIDATED [label="  validate (owner)"];
  RECEIVED -> REJECTED [label="  reject (reason)"];
  { rank=same; VALIDATED; REJECTED; }
}
