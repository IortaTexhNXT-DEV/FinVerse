// BRD-10: STR status. FRS section 5.4; SNSRP-705, 706.
digraph sc_str {
  graph [rankdir=TB, fontname="Arial", nodesep=0.5, ranksep=0.4, bgcolor="white", pad=0.2];
  node  [shape=box, style="rounded,filled", fillcolor="@BG_BLUE", color="@HEADER_BLUE", penwidth=1.1,
         fontname="Arial", fontsize=11, fontcolor="@NEAR_BLACK", width=2.4, height=0.5];
  edge  [color="@MUTED", arrowsize=0.6, fontname="Arial", fontsize=9.5, fontcolor="@TEXT"];

  DRAFT        [label="DRAFT\n(prefilled, editable)"];
  FOR_APPROVAL [label="FOR_APPROVAL\n(complete)"];
  APPROVED     [label="APPROVED\n(AML Committee)"];
  EXTRACTED    [label="EXTRACTED\n(AMLC file saved)"];
  FILED        [label="FILED\n(AMLC reference)", fillcolor="@SUCCESS_BG", color="@SUCCESS"];

  DRAFT -> FOR_APPROVAL [label=" str_ready (completeness check)"];
  FOR_APPROVAL -> APPROVED [label=" committee-approved STR"];
  FOR_APPROVAL -> DRAFT [label=" returned", style=dashed];
  APPROVED -> EXTRACTED [label=" Extract Approved STRs (batch)"];
  EXTRACTED -> FILED [label=" filing reference recorded"];
}
