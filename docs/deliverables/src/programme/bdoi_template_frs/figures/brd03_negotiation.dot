// Negotiation with insurers, Comparative Table and review of negotiated terms (FRPM.006, 008, 009, 012.01-04,
// 013.01-02, 027.01; BRPM.010, 012, 013, 014; PMADD03, PMADD04).
digraph negotiation {
  graph [rankdir=TB, newrank=true, fontname="Arial", nodesep=0.1, ranksep=0.24, bgcolor="white", pad=0.15, splines=polyline];
  node  [shape=box, style="rounded,filled", fontname="Arial", fontsize=10, width=1.0, height=0.45, margin="0.04,0.03"];
  edge  [arrowsize=0.55, penwidth=0.8, color="#333333", fontname="Arial", fontsize=8.5];

  subgraph cluster_tsu { label="TSU Officer"; fontname="Arial Bold"; fontsize=10; style="rounded"; color="#6C8EBF";
    node [fillcolor="#DAE8FC", color="#6C8EBF"];
    h1 [label="", shape=plaintext, style="", width=0.1, height=0.1];
    start [label="Approved\nrequest", shape=ellipse, fillcolor="#FFFFFF", width=0.8, height=0.35];
    t1 [label="Prepare Quotation\nSlip (round n)"];
    t2 [label="Key in each\ninsurer's terms;\nattach reply"];
    t3 [label="Another\nround?", shape=diamond, width=0.9, height=0.6, style="filled"];
    t4 [label="Compile master\nComparative Table;\nclient views"];
    t5 [label="Select insurer(s);\nterms final"];
    t6 [label="Not proceeded\nwith reason", fillcolor="#EEEEEE"];
  }
  subgraph cluster_tl { label="TSU Team Lead"; fontname="Arial Bold"; fontsize=10; style="rounded"; color="#4A6FA5";
    node [fillcolor="#C9DAF8", color="#4A6FA5"];
    h2 [label="", shape=plaintext, style="", width=0.1, height=0.1];
    q1 [label="Approve\nslip?", shape=diamond, width=0.9, height=0.6, style="filled"];
    q2 [label="Return or\nreject with\nremarks"];
  }
  subgraph cluster_ins { label="Insurers"; fontname="Arial Bold"; fontsize=10; style="rounded"; color="#D79B00";
    node [fillcolor="#FFE6CC", color="#D79B00"];
    h3 [label="", shape=plaintext, style="", width=0.1, height=0.1];
    i1 [label="Receive protected\nslip; reply by\nthe reply date"];
    is_ [label="Reply days 5\n(configurable)", shape=note, fillcolor="#FFFBE6", color="#BFA000", fontsize=8.5, width=0.9];
  }
  subgraph cluster_th { label="TSU Head"; fontname="Arial Bold"; fontsize=10; style="rounded"; color="#B85450";
    node [fillcolor="#F8CECC", color="#B85450"];
    h4 [label="", shape=plaintext, style="", width=0.1, height=0.1];
    a1 [label="Review\nnegotiated terms"];
    a2 [label="Client-\nspecific?", shape=diamond, width=0.9, height=0.6, style="filled"];
    as_ [label="Negotiation SLA\n120 h; review 24 h", shape=note, fillcolor="#FFFBE6", color="#BFA000", fontsize=8.5, width=1.0];
  }
  subgraph cluster_mkt { label="Marketing\n(requester)"; fontname="Arial Bold"; fontsize=10; style="rounded"; color="#82B366";
    node [fillcolor="#D5E8D4", color="#82B366"];
    h5 [label="", shape=plaintext, style="", width=0.1, height=0.1];
    k1 [label="Accept\nterms?", shape=diamond, width=0.9, height=0.6, style="filled"];
    ks [label="SLA 48 h", shape=note, fillcolor="#FFFBE6", color="#BFA000", fontsize=8.5, width=0.7];
  }
  subgraph cluster_sys { label="System"; fontname="Arial Bold"; fontsize=10; style="rounded"; color="#666666";
    node [fillcolor="#F5F5F5", color="#666666"];
    h6 [label="", shape=plaintext, style="", width=0.1, height=0.1];
    s1 [label="E-mail slip per\ninsurer, password\nseparately; log"];
    s2 [label="Keep every\nresponse value\nin the history"];
    s3 [label="Requirements\npreparation\n(next figure)", shape=ellipse, fillcolor="#FFFFFF"];
  }
  { rank=same; h1; h2; h3; h4; h5; h6; }
  h1 -> h2 -> h3 -> h4 -> h5 -> h6 [style=invis];
  h1 -> start [style=invis];

  start -> t1 -> q1;
  q1 -> q2 [xlabel="No"];
  q2 -> t1 [style=dashed];
  q1 -> s1 [xlabel="Yes"];
  s1 -> i1 -> t2;
  t2 -> s2 [style=dashed];
  t2 -> t3;
  t3 -> t1 [xlabel="Yes: revised\nslip, new round", style=dashed];
  t3 -> t4 [xlabel="No"];
  t4 -> t5 -> a1 -> a2;
  t3 -> t6 [xlabel="all declined"];
  a2 -> k1 [xlabel="Yes"];
  a2 -> s3 [xlabel="No (generic)"];
  k1 -> s3 [xlabel="Yes"];
  k1 -> t1 [xlabel="Changes\nrequested", style=dashed];
  is_ -> i1 [style=invis]; as_ -> a1 [style=invis]; ks -> k1 [style=invis];
}
