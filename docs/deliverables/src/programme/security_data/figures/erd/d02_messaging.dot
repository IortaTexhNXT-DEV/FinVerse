digraph erd {
  graph [rankdir=LR, fontname="Arial", nodesep=0.3, ranksep=0.8, pad=0.2, bgcolor="white"];
  node [shape=plain, fontname="Arial"];
  edge [color="@CTA_BLUE", arrowsize=0.8, penwidth=1.2, dir=both];
  "msg_notification_event" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>MSG_NOTIFICATION_EVENT</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="code"><font point-size="11">CODE</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 6 columns</font></td></tr></table>>];
  "msg_notification_preference" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>MSG_NOTIFICATION_PREFERENCE</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="event_code"><font point-size="11">EVENT_CODE</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 8 columns</font></td></tr></table>>];
  "msg_outbound" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>MSG_OUTBOUND</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="password_for_id"><font point-size="11">PASSWORD_FOR_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 20 columns</font></td></tr></table>>];
  "msg_outbound_attachment" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>MSG_OUTBOUND_ATTACHMENT</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="message_id"><font point-size="11">MESSAGE_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="stored_file_id"><font point-size="11">STORED_FILE_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 6 columns</font></td></tr></table>>];
  "stored_file" [shape=box, style="rounded,filled", fillcolor="@DIRTY_WHITE", color="@MUTED", fontsize=11, label=<<font color="@MUTED">STORED_FILE<br/><font point-size="9">STORAGE</font></font>>];
  "msg_notification_preference":"event_code" -> "msg_notification_event" [arrowtail=crow, arrowhead=teetee];
  "msg_outbound":"password_for_id" -> "msg_outbound" [arrowtail=crow, arrowhead=teeodot];
  "msg_outbound_attachment":"message_id" -> "msg_outbound" [arrowtail=crow, arrowhead=teetee];
  "msg_outbound_attachment":"stored_file_id" -> "stored_file" [arrowtail=crow, arrowhead=teeodot];
}
