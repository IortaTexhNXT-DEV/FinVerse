digraph erd {
  graph [rankdir=LR, fontname="Arial", nodesep=0.3, ranksep=0.8, pad=0.2, bgcolor="white"];
  node [shape=plain, fontname="Arial"];
  edge [color="@CTA_BLUE", arrowsize=0.8, penwidth=1.2, dir=both];
  "wf_case" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>WF_CASE</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="workflow_code"><font point-size="11">WORKFLOW_CODE</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="stage_code"><font point-size="11">STAGE_CODE</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 16 columns</font></td></tr></table>>];
  "wf_case_history" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>WF_CASE_HISTORY</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="case_id"><font point-size="11">CASE_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 8 columns</font></td></tr></table>>];
  "wf_stage" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>WF_STAGE</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 8 columns</font></td></tr></table>>];
  "wf_transition" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>WF_TRANSITION</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="workflow_code"><font point-size="11">WORKFLOW_CODE</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="from_stage"><font point-size="11">FROM_STAGE</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="to_stage"><font point-size="11">TO_STAGE</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="reason_lov"><font point-size="11">REASON_LOV</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 5 columns</font></td></tr></table>>];
  "lov_type" [shape=box, style="rounded,filled", fillcolor="@DIRTY_WHITE", color="@MUTED", fontsize=11, label=<<font color="@MUTED">LOV_TYPE<br/><font point-size="9">LOV</font></font>>];
  "wf_case":"workflow_code" -> "wf_stage" [arrowtail=crow, arrowhead=teetee];
  "wf_case_history":"case_id" -> "wf_case" [arrowtail=crow, arrowhead=teetee];
  "wf_transition":"workflow_code" -> "wf_stage" [arrowtail=crow, arrowhead=teetee];
  "wf_transition":"workflow_code" -> "wf_stage" [arrowtail=crow, arrowhead=teetee];
  "wf_transition":"reason_lov" -> "lov_type" [arrowtail=crow, arrowhead=teeodot];
}
