digraph erd {
  graph [rankdir=LR, fontname="Arial", nodesep=0.3, ranksep=0.8, pad=0.2, bgcolor="white"];
  node [shape=plain, fontname="Arial"];
  edge [color="@CTA_BLUE", arrowsize=0.8, penwidth=1.2, dir=both];
  "npk_insurer_response" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>NPK_INSURER_RESPONSE</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="proposal_id"><font point-size="11">PROPOSAL_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 18 columns</font></td></tr></table>>];
  "npk_insurer_response_history" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>NPK_INSURER_RESPONSE_HISTORY</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="response_id"><font point-size="11">RESPONSE_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 12 columns</font></td></tr></table>>];
  "npk_proposal" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>NPK_PROPOSAL</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="client_id"><font point-size="11">CLIENT_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="product_code"><font point-size="11">PRODUCT_CODE</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 43 columns</font></td></tr></table>>];
  "npk_proposal_account" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>NPK_PROPOSAL_ACCOUNT</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="proposal_id"><font point-size="11">PROPOSAL_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="account_index"><font point-size="11">ACCOUNT_INDEX</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 1 columns</font></td></tr></table>>];
  "npk_proposal_insurer" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>NPK_PROPOSAL_INSURER</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="proposal_id"><font point-size="11">PROPOSAL_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="insurer_index"><font point-size="11">INSURER_INDEX</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 1 columns</font></td></tr></table>>];
  "cat_product" [shape=box, style="rounded,filled", fillcolor="@DIRTY_WHITE", color="@MUTED", fontsize=11, label=<<font color="@MUTED">CAT_PRODUCT<br/><font point-size="9">CATALOG</font></font>>];
  "crm_client" [shape=box, style="rounded,filled", fillcolor="@DIRTY_WHITE", color="@MUTED", fontsize=11, label=<<font color="@MUTED">CRM_CLIENT<br/><font point-size="9">CRM</font></font>>];
  "npk_insurer_response":"proposal_id" -> "npk_proposal" [arrowtail=crow, arrowhead=teetee];
  "npk_insurer_response_history":"response_id" -> "npk_insurer_response" [arrowtail=crow, arrowhead=teetee];
  "npk_proposal":"client_id" -> "crm_client" [arrowtail=crow, arrowhead=teetee];
  "npk_proposal":"product_code" -> "cat_product" [arrowtail=crow, arrowhead=teetee];
  "npk_proposal_account":"proposal_id" -> "npk_proposal" [arrowtail=crow, arrowhead=teetee];
  "npk_proposal_insurer":"proposal_id" -> "npk_proposal" [arrowtail=crow, arrowhead=teetee];
}
