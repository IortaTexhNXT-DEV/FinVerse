digraph erd {
  graph [rankdir=TB, fontname="Arial", nodesep=0.3, ranksep=0.8, pad=0.2, bgcolor="white"];
  node [shape=plain, fontname="Arial"];
  edge [color="@CTA_BLUE", arrowsize=0.8, penwidth=1.2, dir=both];
  "plc_billing_batch" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>PLC_BILLING_BATCH</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 11 columns</font></td></tr></table>>];
  "plc_billing_item" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>PLC_BILLING_ITEM</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="batch_id"><font point-size="11">BATCH_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="account_id"><font point-size="11">ACCOUNT_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 11 columns</font></td></tr></table>>];
  "plc_hold_cover" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>PLC_HOLD_COVER</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="account_id"><font point-size="11">ACCOUNT_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 14 columns</font></td></tr></table>>];
  "plc_insurer_return" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>PLC_INSURER_RETURN</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="account_id"><font point-size="11">ACCOUNT_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 13 columns</font></td></tr></table>>];
  "plc_payment_evidence" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>PLC_PAYMENT_EVIDENCE</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="account_id"><font point-size="11">ACCOUNT_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 16 columns</font></td></tr></table>>];
  "plc_payment_report" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>PLC_PAYMENT_REPORT</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="batch_id"><font point-size="11">BATCH_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 12 columns</font></td></tr></table>>];
  "plc_payment_report_line" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>PLC_PAYMENT_REPORT_LINE</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="report_id"><font point-size="11">REPORT_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="account_id"><font point-size="11">ACCOUNT_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 12 columns</font></td></tr></table>>];
  "plc_slip" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>PLC_SLIP</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 15 columns</font></td></tr></table>>];
  "plc_slip_account" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>PLC_SLIP_ACCOUNT</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="slip_id"><font point-size="11">SLIP_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="line_index"><font point-size="11">LINE_INDEX</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="account_id"><font point-size="11">ACCOUNT_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 1 columns</font></td></tr></table>>];
  "plc_slip_file" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>PLC_SLIP_FILE</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="slip_id"><font point-size="11">SLIP_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="stored_file_id"><font point-size="11">STORED_FILE_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 4 columns</font></td></tr></table>>];
  "acc_account" [shape=box, style="rounded,filled", fillcolor="@DIRTY_WHITE", color="@MUTED", fontsize=11, label=<<font color="@MUTED">ACC_ACCOUNT<br/><font point-size="9">ACCOUNT</font></font>>];
  "stored_file" [shape=box, style="rounded,filled", fillcolor="@DIRTY_WHITE", color="@MUTED", fontsize=11, label=<<font color="@MUTED">STORED_FILE<br/><font point-size="9">STORAGE</font></font>>];
  "plc_billing_item":"account_id" -> "acc_account" [arrowtail=crow, arrowhead=teetee];
  "plc_billing_item":"batch_id" -> "plc_billing_batch" [arrowtail=crow, arrowhead=teetee];
  "plc_hold_cover":"account_id" -> "acc_account" [arrowtail=crow, arrowhead=teetee];
  "plc_insurer_return":"account_id" -> "acc_account" [arrowtail=crow, arrowhead=teetee];
  "plc_payment_evidence":"account_id" -> "acc_account" [arrowtail=crow, arrowhead=teetee];
  "plc_payment_report":"batch_id" -> "plc_billing_batch" [arrowtail=crow, arrowhead=teeodot];
  "plc_payment_report_line":"account_id" -> "acc_account" [arrowtail=crow, arrowhead=teeodot];
  "plc_payment_report_line":"report_id" -> "plc_payment_report" [arrowtail=crow, arrowhead=teetee];
  "plc_slip_account":"account_id" -> "acc_account" [arrowtail=crow, arrowhead=teetee];
  "plc_slip_account":"slip_id" -> "plc_slip" [arrowtail=crow, arrowhead=teetee];
  "plc_slip_file":"slip_id" -> "plc_slip" [arrowtail=crow, arrowhead=teetee];
  "plc_slip_file":"stored_file_id" -> "stored_file" [arrowtail=crow, arrowhead=teeodot];
}
