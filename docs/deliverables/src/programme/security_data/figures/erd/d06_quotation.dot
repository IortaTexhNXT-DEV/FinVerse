digraph erd {
  graph [rankdir=LR, fontname="Arial", nodesep=0.3, ranksep=0.8, pad=0.2, bgcolor="white"];
  node [shape=plain, fontname="Arial"];
  edge [color="@CTA_BLUE", arrowsize=0.8, penwidth=1.2, dir=both];
  "quo_quotation" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>QUO_QUOTATION</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="request_id"><font point-size="11">REQUEST_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="client_id"><font point-size="11">CLIENT_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="product_code"><font point-size="11">PRODUCT_CODE</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 43 columns</font></td></tr></table>>];
  "quo_quotation_account" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>QUO_QUOTATION_ACCOUNT</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="quotation_id"><font point-size="11">QUOTATION_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="account_index"><font point-size="11">ACCOUNT_INDEX</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 1 columns</font></td></tr></table>>];
  "quo_request" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>QUO_REQUEST</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="client_id"><font point-size="11">CLIENT_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="product_code"><font point-size="11">PRODUCT_CODE</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 18 columns</font></td></tr></table>>];
  "quo_version" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>QUO_VERSION</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="quotation_id"><font point-size="11">QUOTATION_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 12 columns</font></td></tr></table>>];
  "cat_product" [shape=box, style="rounded,filled", fillcolor="@DIRTY_WHITE", color="@MUTED", fontsize=11, label=<<font color="@MUTED">CAT_PRODUCT<br/><font point-size="9">CATALOG</font></font>>];
  "crm_client" [shape=box, style="rounded,filled", fillcolor="@DIRTY_WHITE", color="@MUTED", fontsize=11, label=<<font color="@MUTED">CRM_CLIENT<br/><font point-size="9">CRM</font></font>>];
  "quo_quotation":"client_id" -> "crm_client" [arrowtail=crow, arrowhead=teetee];
  "quo_quotation":"product_code" -> "cat_product" [arrowtail=crow, arrowhead=teetee];
  "quo_quotation":"request_id" -> "quo_request" [arrowtail=crow, arrowhead=teeodot];
  "quo_quotation_account":"quotation_id" -> "quo_quotation" [arrowtail=crow, arrowhead=teetee];
  "quo_request":"client_id" -> "crm_client" [arrowtail=crow, arrowhead=teeodot];
  "quo_request":"product_code" -> "cat_product" [arrowtail=crow, arrowhead=teeodot];
  "quo_version":"quotation_id" -> "quo_quotation" [arrowtail=crow, arrowhead=teetee];
}
