digraph erd {
  graph [rankdir=LR, fontname="Arial", nodesep=0.3, ranksep=0.8, pad=0.2, bgcolor="white"];
  node [shape=plain, fontname="Arial"];
  edge [color="@CTA_BLUE", arrowsize=0.8, penwidth=1.2, dir=both];
  "csh_application" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>CSH_APPLICATION</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="receipt_id"><font point-size="11">RECEIPT_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="unapplied_id"><font point-size="11">UNAPPLIED_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 21 columns</font></td></tr></table>>];
  "csh_application_line" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>CSH_APPLICATION_LINE</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="application_id"><font point-size="11">APPLICATION_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="seq"><font point-size="11">SEQ</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 2 columns</font></td></tr></table>>];
  "csh_collector_request" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>CSH_COLLECTOR_REQUEST</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="unapplied_id"><font point-size="11">UNAPPLIED_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="disposition_id"><font point-size="11">DISPOSITION_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 18 columns</font></td></tr></table>>];
  "csh_disposition" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>CSH_DISPOSITION</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="unapplied_id"><font point-size="11">UNAPPLIED_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="disposition_type"><font point-size="11">DISPOSITION_TYPE</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="application_id"><font point-size="11">APPLICATION_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 23 columns</font></td></tr></table>>];
  "csh_disposition_type_rule" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>CSH_DISPOSITION_TYPE_RULE</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="type_code"><font point-size="11">TYPE_CODE</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 6 columns</font></td></tr></table>>];
  "csh_payment" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>CSH_PAYMENT</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="receipt_id"><font point-size="11">RECEIPT_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 29 columns</font></td></tr></table>>];
  "csh_payment_reversal" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>CSH_PAYMENT_REVERSAL</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="unapplied_id"><font point-size="11">UNAPPLIED_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 21 columns</font></td></tr></table>>];
  "csh_pdc_item" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>CSH_PDC_ITEM</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="payment_id"><font point-size="11">PAYMENT_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 22 columns</font></td></tr></table>>];
  "csh_pickup_request" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>CSH_PICKUP_REQUEST</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="payment_id"><font point-size="11">PAYMENT_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 22 columns</font></td></tr></table>>];
  "csh_prebooked" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>CSH_PREBOOKED</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="payment_id"><font point-size="11">PAYMENT_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="receipt_id"><font point-size="11">RECEIPT_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="application_id"><font point-size="11">APPLICATION_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 16 columns</font></td></tr></table>>];
  "csh_receipt" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>CSH_RECEIPT</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="series_id"><font point-size="11">SERIES_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 37 columns</font></td></tr></table>>];
  "csh_refund_validation" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>CSH_REFUND_VALIDATION</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="unapplied_id"><font point-size="11">UNAPPLIED_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 21 columns</font></td></tr></table>>];
  "csh_unapplied" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>CSH_UNAPPLIED</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="receipt_id"><font point-size="11">RECEIPT_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="payment_id"><font point-size="11">PAYMENT_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 28 columns</font></td></tr></table>>];
  "csh_receipt_series" [shape=box, style="rounded,filled", fillcolor="@DIRTY_WHITE", color="@MUTED", fontsize=11, label=<<font color="@MUTED">CSH_RECEIPT_SERIES<br/><font point-size="9">CASHIERING</font></font>>];
  "csh_application":"receipt_id" -> "csh_receipt" [arrowtail=crow, arrowhead=teeodot];
  "csh_application":"unapplied_id" -> "csh_unapplied" [arrowtail=crow, arrowhead=teeodot];
  "csh_application_line":"application_id" -> "csh_application" [arrowtail=crow, arrowhead=teetee];
  "csh_collector_request":"disposition_id" -> "csh_disposition" [arrowtail=crow, arrowhead=teeodot];
  "csh_collector_request":"unapplied_id" -> "csh_unapplied" [arrowtail=crow, arrowhead=teetee];
  "csh_disposition":"disposition_type" -> "csh_disposition_type_rule" [arrowtail=crow, arrowhead=teetee];
  "csh_disposition":"unapplied_id" -> "csh_unapplied" [arrowtail=crow, arrowhead=teetee];
  "csh_disposition":"application_id" -> "csh_application" [arrowtail=crow, arrowhead=teeodot];
  "csh_payment":"receipt_id" -> "csh_receipt" [arrowtail=crow, arrowhead=teeodot];
  "csh_payment_reversal":"unapplied_id" -> "csh_unapplied" [arrowtail=crow, arrowhead=teeodot];
  "csh_pdc_item":"payment_id" -> "csh_payment" [arrowtail=crow, arrowhead=teeodot];
  "csh_pickup_request":"payment_id" -> "csh_payment" [arrowtail=crow, arrowhead=teeodot];
  "csh_prebooked":"application_id" -> "csh_application" [arrowtail=crow, arrowhead=teeodot];
  "csh_prebooked":"payment_id" -> "csh_payment" [arrowtail=crow, arrowhead=teetee];
  "csh_prebooked":"receipt_id" -> "csh_receipt" [arrowtail=crow, arrowhead=teetee];
  "csh_receipt":"series_id" -> "csh_receipt_series" [arrowtail=crow, arrowhead=teeodot];
  "csh_refund_validation":"unapplied_id" -> "csh_unapplied" [arrowtail=crow, arrowhead=teeodot];
  "csh_unapplied":"payment_id" -> "csh_payment" [arrowtail=crow, arrowhead=teeodot];
  "csh_unapplied":"receipt_id" -> "csh_receipt" [arrowtail=crow, arrowhead=teeodot];
}
