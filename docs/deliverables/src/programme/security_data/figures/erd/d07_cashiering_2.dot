digraph erd {
  graph [rankdir=TB, fontname="Arial", nodesep=0.3, ranksep=0.8, pad=0.2, bgcolor="white"];
  node [shape=plain, fontname="Arial"];
  edge [color="@CTA_BLUE", arrowsize=0.8, penwidth=1.2, dir=both];
  "csh_channel_file" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>CSH_CHANNEL_FILE</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="file_type"><font point-size="11">FILE_TYPE</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 24 columns</font></td></tr></table>>];
  "csh_channel_profile" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>CSH_CHANNEL_PROFILE</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="file_type"><font point-size="11">FILE_TYPE</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 20 columns</font></td></tr></table>>];
  "csh_cwt_batch" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>CSH_CWT_BATCH</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 14 columns</font></td></tr></table>>];
  "csh_cwt_tag" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>CSH_CWT_TAG</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="batch_id"><font point-size="11">BATCH_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 23 columns</font></td></tr></table>>];
  "csh_legacy_batch" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>CSH_LEGACY_BATCH</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 23 columns</font></td></tr></table>>];
  "csh_legacy_batch_line" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>CSH_LEGACY_BATCH_LINE</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="batch_id"><font point-size="11">BATCH_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 11 columns</font></td></tr></table>>];
  "csh_print_batch" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>CSH_PRINT_BATCH</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="stored_file_id"><font point-size="11">STORED_FILE_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="zip_file_id"><font point-size="11">ZIP_FILE_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 16 columns</font></td></tr></table>>];
  "csh_print_line" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>CSH_PRINT_LINE</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="print_batch_id"><font point-size="11">PRINT_BATCH_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="line_no"><font point-size="11">LINE_NO</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="receipt_id"><font point-size="11">RECEIPT_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 5 columns</font></td></tr></table>>];
  "csh_receipt_record" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>CSH_RECEIPT_RECORD</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="receipt_id"><font point-size="11">RECEIPT_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 47 columns</font></td></tr></table>>];
  "csh_receipt_record_account" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>CSH_RECEIPT_RECORD_ACCOUNT</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="record_id"><font point-size="11">RECORD_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="line_no"><font point-size="11">LINE_NO</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 2 columns</font></td></tr></table>>];
  "csh_receipt" [shape=box, style="rounded,filled", fillcolor="@DIRTY_WHITE", color="@MUTED", fontsize=11, label=<<font color="@MUTED">CSH_RECEIPT<br/><font point-size="9">CASHIERING</font></font>>];
  "stored_file" [shape=box, style="rounded,filled", fillcolor="@DIRTY_WHITE", color="@MUTED", fontsize=11, label=<<font color="@MUTED">STORED_FILE<br/><font point-size="9">STORAGE</font></font>>];
  "csh_channel_file":"file_type" -> "csh_channel_profile" [arrowtail=crow, arrowhead=teetee];
  "csh_cwt_tag":"batch_id" -> "csh_cwt_batch" [arrowtail=crow, arrowhead=teeodot];
  "csh_legacy_batch_line":"batch_id" -> "csh_legacy_batch" [arrowtail=crow, arrowhead=teetee];
  "csh_print_batch":"stored_file_id" -> "stored_file" [arrowtail=crow, arrowhead=teeodot];
  "csh_print_batch":"zip_file_id" -> "stored_file" [arrowtail=crow, arrowhead=teeodot];
  "csh_print_line":"print_batch_id" -> "csh_print_batch" [arrowtail=crow, arrowhead=teetee];
  "csh_print_line":"receipt_id" -> "csh_receipt" [arrowtail=crow, arrowhead=teetee];
  "csh_receipt_record":"receipt_id" -> "csh_receipt" [arrowtail=crow, arrowhead=teeodot];
  "csh_receipt_record_account":"record_id" -> "csh_receipt_record" [arrowtail=crow, arrowhead=teetee];
}
