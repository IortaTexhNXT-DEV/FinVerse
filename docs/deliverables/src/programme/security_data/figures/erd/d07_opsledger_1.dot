digraph erd {
  graph [rankdir=LR, fontname="Arial", nodesep=0.3, ranksep=0.8, pad=0.2, bgcolor="white"];
  node [shape=plain, fontname="Arial"];
  edge [color="@CTA_BLUE", arrowsize=0.8, penwidth=1.2, dir=both];
  "ops_flow_in_feed" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>OPS_FLOW_IN_FEED</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 14 columns</font></td></tr></table>>];
  "ops_flow_in_record" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>OPS_FLOW_IN_RECORD</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="feed_code"><font point-size="11">FEED_CODE</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="run_id"><font point-size="11">RUN_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 6 columns</font></td></tr></table>>];
  "ops_flow_in_run" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>OPS_FLOW_IN_RUN</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="feed_code"><font point-size="11">FEED_CODE</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 18 columns</font></td></tr></table>>];
  "ops_invoice" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>OPS_INVOICE</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 56 columns</font></td></tr></table>>];
  "ops_invoice_component" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>OPS_INVOICE_COMPONENT</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="invoice_id"><font point-size="11">INVOICE_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 13 columns</font></td></tr></table>>];
  "ops_invoice_movement" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>OPS_INVOICE_MOVEMENT</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="invoice_id"><font point-size="11">INVOICE_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 13 columns</font></td></tr></table>>];
  "ops_invoice_origin_line" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>OPS_INVOICE_ORIGIN_LINE</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="snapshot_id"><font point-size="11">SNAPSHOT_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="line_index"><font point-size="11">LINE_INDEX</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 7 columns</font></td></tr></table>>];
  "ops_invoice_origin_snapshot" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>OPS_INVOICE_ORIGIN_SNAPSHOT</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="invoice_id"><font point-size="11">INVOICE_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 18 columns</font></td></tr></table>>];
  "ops_invoice_share" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>OPS_INVOICE_SHARE</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="invoice_id"><font point-size="11">INVOICE_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="share_index"><font point-size="11">SHARE_INDEX</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 3 columns</font></td></tr></table>>];
  "ops_invoice_status_change" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>OPS_INVOICE_STATUS_CHANGE</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="invoice_id"><font point-size="11">INVOICE_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 7 columns</font></td></tr></table>>];
  "ops_flow_in_record":"feed_code" -> "ops_flow_in_feed" [arrowtail=crow, arrowhead=teetee];
  "ops_flow_in_record":"run_id" -> "ops_flow_in_run" [arrowtail=crow, arrowhead=teetee];
  "ops_flow_in_run":"feed_code" -> "ops_flow_in_feed" [arrowtail=crow, arrowhead=teetee];
  "ops_invoice_component":"invoice_id" -> "ops_invoice" [arrowtail=crow, arrowhead=teetee];
  "ops_invoice_movement":"invoice_id" -> "ops_invoice" [arrowtail=crow, arrowhead=teetee];
  "ops_invoice_origin_line":"snapshot_id" -> "ops_invoice_origin_snapshot" [arrowtail=crow, arrowhead=teetee];
  "ops_invoice_origin_snapshot":"invoice_id" -> "ops_invoice" [arrowtail=crow, arrowhead=teetee];
  "ops_invoice_share":"invoice_id" -> "ops_invoice" [arrowtail=crow, arrowhead=teetee];
  "ops_invoice_status_change":"invoice_id" -> "ops_invoice" [arrowtail=crow, arrowhead=teetee];
}
