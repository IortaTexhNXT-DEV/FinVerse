digraph erd {
  graph [rankdir=LR, fontname="Arial", nodesep=0.3, ranksep=0.8, pad=0.2, bgcolor="white"];
  node [shape=plain, fontname="Arial"];
  edge [color="@CTA_BLUE", arrowsize=0.8, penwidth=1.2, dir=both];
  "prc_cycle" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>PRC_CYCLE</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 15 columns</font></td></tr></table>>];
  "prc_extract" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>PRC_EXTRACT</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="cycle_id"><font point-size="11">CYCLE_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="file_id"><font point-size="11">FILE_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 17 columns</font></td></tr></table>>];
  "prc_extract_line" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>PRC_EXTRACT_LINE</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="extract_id"><font point-size="11">EXTRACT_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 29 columns</font></td></tr></table>>];
  "prc_item" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>PRC_ITEM</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="cycle_id"><font point-size="11">CYCLE_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="extract_line_id"><font point-size="11">EXTRACT_LINE_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="upload_id"><font point-size="11">UPLOAD_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 48 columns</font></td></tr></table>>];
  "prc_upload" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>PRC_UPLOAD</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="cycle_id"><font point-size="11">CYCLE_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 17 columns</font></td></tr></table>>];
  "ops_extract_file" [shape=box, style="rounded,filled", fillcolor="@DIRTY_WHITE", color="@MUTED", fontsize=11, label=<<font color="@MUTED">OPS_EXTRACT_FILE<br/><font point-size="9">OPSLEDGER</font></font>>];
  "prc_extract":"cycle_id" -> "prc_cycle" [arrowtail=crow, arrowhead=teetee];
  "prc_extract":"file_id" -> "ops_extract_file" [arrowtail=crow, arrowhead=teeodot];
  "prc_extract_line":"extract_id" -> "prc_extract" [arrowtail=crow, arrowhead=teetee];
  "prc_item":"cycle_id" -> "prc_cycle" [arrowtail=crow, arrowhead=teetee];
  "prc_item":"extract_line_id" -> "prc_extract_line" [arrowtail=crow, arrowhead=teeodot];
  "prc_item":"upload_id" -> "prc_upload" [arrowtail=crow, arrowhead=teeodot];
  "prc_upload":"cycle_id" -> "prc_cycle" [arrowtail=crow, arrowhead=teeodot];
}
