digraph erd {
  graph [rankdir=LR, fontname="Arial", nodesep=0.3, ranksep=0.8, pad=0.2, bgcolor="white"];
  node [shape=plain, fontname="Arial"];
  edge [color="@CTA_BLUE", arrowsize=0.8, penwidth=1.2, dir=both];
  "bud_budget" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>BUD_BUDGET</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="based_on_id"><font point-size="11">BASED_ON_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 17 columns</font></td></tr></table>>];
  "bud_budget_amount" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>BUD_BUDGET_AMOUNT</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="line_id"><font point-size="11">LINE_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="period_no"><font point-size="11">PERIOD_NO</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 1 columns</font></td></tr></table>>];
  "bud_budget_line" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>BUD_BUDGET_LINE</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="budget_id"><font point-size="11">BUDGET_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="account_id"><font point-size="11">ACCOUNT_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 2 columns</font></td></tr></table>>];
  "coa_account" [shape=box, style="rounded,filled", fillcolor="@DIRTY_WHITE", color="@MUTED", fontsize=11, label=<<font color="@MUTED">COA_ACCOUNT<br/><font point-size="9">COA</font></font>>];
  "bud_budget":"based_on_id" -> "bud_budget" [arrowtail=crow, arrowhead=teeodot];
  "bud_budget_amount":"line_id" -> "bud_budget_line" [arrowtail=crow, arrowhead=teetee];
  "bud_budget_line":"account_id" -> "coa_account" [arrowtail=crow, arrowhead=teetee];
  "bud_budget_line":"budget_id" -> "bud_budget" [arrowtail=crow, arrowhead=teetee];
}
