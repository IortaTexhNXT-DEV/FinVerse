digraph erd {
  graph [rankdir=LR, fontname="Arial", nodesep=0.3, ranksep=0.8, pad=0.2, bgcolor="white"];
  node [shape=plain, fontname="Arial"];
  edge [color="@CTA_BLUE", arrowsize=0.8, penwidth=1.2, dir=both];
  "acc_period_close_schedule" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>ACC_PERIOD_CLOSE_SCHEDULE</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="period_id"><font point-size="11">PERIOD_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 10 columns</font></td></tr></table>>];
  "fx_revaluation_line" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>FX_REVALUATION_LINE</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="run_id"><font point-size="11">RUN_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="account_id"><font point-size="11">ACCOUNT_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 10 columns</font></td></tr></table>>];
  "fx_revaluation_run" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>FX_REVALUATION_RUN</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="period_id"><font point-size="11">PERIOD_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 16 columns</font></td></tr></table>>];
  "yec_year_end_close" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>YEC_YEAR_END_CLOSE</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="fiscal_year_id"><font point-size="11">FISCAL_YEAR_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 17 columns</font></td></tr></table>>];
  "coa_account" [shape=box, style="rounded,filled", fillcolor="@DIRTY_WHITE", color="@MUTED", fontsize=11, label=<<font color="@MUTED">COA_ACCOUNT<br/><font point-size="9">COA</font></font>>];
  "per_fiscal_year" [shape=box, style="rounded,filled", fillcolor="@DIRTY_WHITE", color="@MUTED", fontsize=11, label=<<font color="@MUTED">PER_FISCAL_YEAR<br/><font point-size="9">PERIOD</font></font>>];
  "per_period" [shape=box, style="rounded,filled", fillcolor="@DIRTY_WHITE", color="@MUTED", fontsize=11, label=<<font color="@MUTED">PER_PERIOD<br/><font point-size="9">PERIOD</font></font>>];
  "acc_period_close_schedule":"period_id" -> "per_period" [arrowtail=crow, arrowhead=teetee];
  "fx_revaluation_line":"account_id" -> "coa_account" [arrowtail=crow, arrowhead=teetee];
  "fx_revaluation_line":"run_id" -> "fx_revaluation_run" [arrowtail=crow, arrowhead=teetee];
  "fx_revaluation_run":"period_id" -> "per_period" [arrowtail=crow, arrowhead=teetee];
  "yec_year_end_close":"fiscal_year_id" -> "per_fiscal_year" [arrowtail=crow, arrowhead=teetee];
}
