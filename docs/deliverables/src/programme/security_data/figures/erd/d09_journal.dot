digraph erd {
  graph [rankdir=LR, fontname="Arial", nodesep=0.3, ranksep=0.8, pad=0.2, bgcolor="white"];
  node [shape=plain, fontname="Arial"];
  edge [color="@CTA_BLUE", arrowsize=0.8, penwidth=1.2, dir=both];
  "jnl_batch" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>JNL_BATCH</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="period_id"><font point-size="11">PERIOD_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="reversal_of_id"><font point-size="11">REVERSAL_OF_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="reversed_by_id"><font point-size="11">REVERSED_BY_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="corrects_batch_id"><font point-size="11">CORRECTS_BATCH_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 32 columns</font></td></tr></table>>];
  "jnl_line" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>JNL_LINE</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="batch_id"><font point-size="11">BATCH_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="account_id"><font point-size="11">ACCOUNT_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 12 columns</font></td></tr></table>>];
  "jnl_recurring_line" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>JNL_RECURRING_LINE</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="template_id"><font point-size="11">TEMPLATE_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="line_no"><font point-size="11">LINE_NO</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 11 columns</font></td></tr></table>>];
  "jnl_recurring_occurrence" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>JNL_RECURRING_OCCURRENCE</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="template_id"><font point-size="11">TEMPLATE_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="batch_id"><font point-size="11">BATCH_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="reversal_batch_id"><font point-size="11">REVERSAL_BATCH_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 3 columns</font></td></tr></table>>];
  "jnl_recurring_template" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>JNL_RECURRING_TEMPLATE</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 20 columns</font></td></tr></table>>];
  "coa_account" [shape=box, style="rounded,filled", fillcolor="@DIRTY_WHITE", color="@MUTED", fontsize=11, label=<<font color="@MUTED">COA_ACCOUNT<br/><font point-size="9">COA</font></font>>];
  "per_period" [shape=box, style="rounded,filled", fillcolor="@DIRTY_WHITE", color="@MUTED", fontsize=11, label=<<font color="@MUTED">PER_PERIOD<br/><font point-size="9">PERIOD</font></font>>];
  "jnl_batch":"corrects_batch_id" -> "jnl_batch" [arrowtail=crow, arrowhead=teeodot];
  "jnl_batch":"period_id" -> "per_period" [arrowtail=crow, arrowhead=teeodot];
  "jnl_batch":"reversal_of_id" -> "jnl_batch" [arrowtail=crow, arrowhead=teeodot];
  "jnl_batch":"reversed_by_id" -> "jnl_batch" [arrowtail=crow, arrowhead=teeodot];
  "jnl_line":"account_id" -> "coa_account" [arrowtail=crow, arrowhead=teetee];
  "jnl_line":"batch_id" -> "jnl_batch" [arrowtail=crow, arrowhead=teetee];
  "jnl_recurring_line":"template_id" -> "jnl_recurring_template" [arrowtail=crow, arrowhead=teetee];
  "jnl_recurring_occurrence":"batch_id" -> "jnl_batch" [arrowtail=crow, arrowhead=teetee];
  "jnl_recurring_occurrence":"reversal_batch_id" -> "jnl_batch" [arrowtail=crow, arrowhead=teeodot];
  "jnl_recurring_occurrence":"template_id" -> "jnl_recurring_template" [arrowtail=crow, arrowhead=teetee];
}
