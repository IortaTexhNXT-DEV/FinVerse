digraph erd {
  graph [rankdir=TB, fontname="Arial", nodesep=0.3, ranksep=0.8, pad=0.2, bgcolor="white"];
  node [shape=plain, fontname="Arial"];
  edge [color="@CTA_BLUE", arrowsize=0.8, penwidth=1.2, dir=both];
  "gl_daily_balance" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>GL_DAILY_BALANCE</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="company_id"><font point-size="11">COMPANY_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="branch_id"><font point-size="11">BRANCH_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="account_id"><font point-size="11">ACCOUNT_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="currency"><font point-size="11">CURRENCY</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="balance_date"><font point-size="11">BALANCE_DATE</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 4 columns</font></td></tr></table>>];
  "gl_ledger_entry" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>GL_LEDGER_ENTRY</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="account_id"><font point-size="11">ACCOUNT_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="period_id"><font point-size="11">PERIOD_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="batch_id"><font point-size="11">BATCH_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 18 columns</font></td></tr></table>>];
  "coa_account" [shape=box, style="rounded,filled", fillcolor="@DIRTY_WHITE", color="@MUTED", fontsize=11, label=<<font color="@MUTED">COA_ACCOUNT<br/><font point-size="9">COA</font></font>>];
  "jnl_batch" [shape=box, style="rounded,filled", fillcolor="@DIRTY_WHITE", color="@MUTED", fontsize=11, label=<<font color="@MUTED">JNL_BATCH<br/><font point-size="9">JOURNAL</font></font>>];
  "per_period" [shape=box, style="rounded,filled", fillcolor="@DIRTY_WHITE", color="@MUTED", fontsize=11, label=<<font color="@MUTED">PER_PERIOD<br/><font point-size="9">PERIOD</font></font>>];
  "gl_daily_balance":"account_id" -> "coa_account" [arrowtail=crow, arrowhead=teetee];
  "gl_ledger_entry":"account_id" -> "coa_account" [arrowtail=crow, arrowhead=teetee];
  "gl_ledger_entry":"batch_id" -> "jnl_batch" [arrowtail=crow, arrowhead=teetee];
  "gl_ledger_entry":"period_id" -> "per_period" [arrowtail=crow, arrowhead=teetee];
}
