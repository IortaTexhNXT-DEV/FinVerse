digraph erd {
  graph [rankdir=TB, fontname="Arial", nodesep=0.3, ranksep=0.8, pad=0.2, bgcolor="white"];
  node [shape=plain, fontname="Arial"];
  edge [color="@CTA_BLUE", arrowsize=0.8, penwidth=1.2, dir=both];
  "brs_match" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>BRS_MATCH</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 10 columns</font></td></tr></table>>];
  "brs_match_book" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>BRS_MATCH_BOOK</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="match_id"><font point-size="11">MATCH_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="ledger_entry_id"><font point-size="11">LEDGER_ENTRY_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 6 columns</font></td></tr></table>>];
  "brs_statement" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>BRS_STATEMENT</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 16 columns</font></td></tr></table>>];
  "brs_statement_line" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>BRS_STATEMENT_LINE</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="statement_id"><font point-size="11">STATEMENT_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="match_id"><font point-size="11">MATCH_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 14 columns</font></td></tr></table>>];
  "rcv_deposit_slip" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>RCV_DEPOSIT_SLIP</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 16 columns</font></td></tr></table>>];
  "rcv_pdc" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>RCV_PDC</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="party_id"><font point-size="11">PARTY_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="debit_item_id"><font point-size="11">DEBIT_ITEM_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="receipt_id"><font point-size="11">RECEIPT_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="replaced_by_id"><font point-size="11">REPLACED_BY_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 23 columns</font></td></tr></table>>];
  "rcv_pdc_event" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>RCV_PDC_EVENT</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="pdc_id"><font point-size="11">PDC_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 10 columns</font></td></tr></table>>];
  "rcv_receipt" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>RCV_RECEIPT</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="party_id"><font point-size="11">PARTY_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="credit_item_id"><font point-size="11">CREDIT_ITEM_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="deposit_slip_id"><font point-size="11">DEPOSIT_SLIP_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="pdc_id"><font point-size="11">PDC_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 36 columns</font></td></tr></table>>];
  "rcv_receipt_allocation" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>RCV_RECEIPT_ALLOCATION</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="receipt_id"><font point-size="11">RECEIPT_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="debit_item_id"><font point-size="11">DEBIT_ITEM_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 9 columns</font></td></tr></table>>];
  "gl_ledger_entry" [shape=box, style="rounded,filled", fillcolor="@DIRTY_WHITE", color="@MUTED", fontsize=11, label=<<font color="@MUTED">GL_LEDGER_ENTRY<br/><font point-size="9">LEDGER</font></font>>];
  "pty_party" [shape=box, style="rounded,filled", fillcolor="@DIRTY_WHITE", color="@MUTED", fontsize=11, label=<<font color="@MUTED">PTY_PARTY<br/><font point-size="9">PARTY</font></font>>];
  "sl_open_item" [shape=box, style="rounded,filled", fillcolor="@DIRTY_WHITE", color="@MUTED", fontsize=11, label=<<font color="@MUTED">SL_OPEN_ITEM<br/><font point-size="9">SUBLEDGER</font></font>>];
  "brs_match_book":"ledger_entry_id" -> "gl_ledger_entry" [arrowtail=crow, arrowhead=teetee];
  "brs_match_book":"match_id" -> "brs_match" [arrowtail=crow, arrowhead=teetee];
  "brs_statement_line":"match_id" -> "brs_match" [arrowtail=crow, arrowhead=teeodot];
  "brs_statement_line":"statement_id" -> "brs_statement" [arrowtail=crow, arrowhead=teetee];
  "rcv_pdc":"debit_item_id" -> "sl_open_item" [arrowtail=crow, arrowhead=teeodot];
  "rcv_pdc":"party_id" -> "pty_party" [arrowtail=crow, arrowhead=teetee];
  "rcv_pdc":"receipt_id" -> "rcv_receipt" [arrowtail=crow, arrowhead=teeodot];
  "rcv_pdc":"replaced_by_id" -> "rcv_pdc" [arrowtail=crow, arrowhead=teeodot];
  "rcv_pdc_event":"pdc_id" -> "rcv_pdc" [arrowtail=crow, arrowhead=teetee];
  "rcv_receipt":"pdc_id" -> "rcv_pdc" [arrowtail=crow, arrowhead=teeodot];
  "rcv_receipt":"credit_item_id" -> "sl_open_item" [arrowtail=crow, arrowhead=teeodot];
  "rcv_receipt":"deposit_slip_id" -> "rcv_deposit_slip" [arrowtail=crow, arrowhead=teeodot];
  "rcv_receipt":"party_id" -> "pty_party" [arrowtail=crow, arrowhead=teeodot];
  "rcv_receipt_allocation":"debit_item_id" -> "sl_open_item" [arrowtail=crow, arrowhead=teetee];
  "rcv_receipt_allocation":"receipt_id" -> "rcv_receipt" [arrowtail=crow, arrowhead=teetee];
}
