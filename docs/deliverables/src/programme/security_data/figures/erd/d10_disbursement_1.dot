digraph erd {
  graph [rankdir=LR, fontname="Arial", nodesep=0.3, ranksep=0.8, pad=0.2, bgcolor="white"];
  node [shape=plain, fontname="Arial"];
  edge [color="@CTA_BLUE", arrowsize=0.8, penwidth=1.2, dir=both];
  "dsb_eod_output" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>DSB_EOD_OUTPUT</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="eod_run_id"><font point-size="11">EOD_RUN_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="stored_file_id"><font point-size="11">STORED_FILE_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 11 columns</font></td></tr></table>>];
  "dsb_eod_run" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>DSB_EOD_RUN</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 16 columns</font></td></tr></table>>];
  "dsb_instrument" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>DSB_INSTRUMENT</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="voucher_id"><font point-size="11">VOUCHER_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="bank_account_id"><font point-size="11">BANK_ACCOUNT_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="eod_run_id"><font point-size="11">EOD_RUN_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 22 columns</font></td></tr></table>>];
  "dsb_instrument_event" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>DSB_INSTRUMENT_EVENT</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="instrument_id"><font point-size="11">INSTRUMENT_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 10 columns</font></td></tr></table>>];
  "dsb_payee" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>DSB_PAYEE</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 26 columns</font></td></tr></table>>];
  "dsb_payee_account" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>DSB_PAYEE_ACCOUNT</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="payee_id"><font point-size="11">PAYEE_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 13 columns</font></td></tr></table>>];
  "dsb_payee_request" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>DSB_PAYEE_REQUEST</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="payee_id"><font point-size="11">PAYEE_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 14 columns</font></td></tr></table>>];
  "dsb_request" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>DSB_REQUEST</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="payee_id"><font point-size="11">PAYEE_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="voucher_id"><font point-size="11">VOUCHER_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 29 columns</font></td></tr></table>>];
  "dsb_status_edit" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>DSB_STATUS_EDIT</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="instrument_id"><font point-size="11">INSTRUMENT_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 12 columns</font></td></tr></table>>];
  "dsb_voucher" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>DSB_VOUCHER</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="request_id"><font point-size="11">REQUEST_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="payee_id"><font point-size="11">PAYEE_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="bank_account_id"><font point-size="11">BANK_ACCOUNT_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="payee_account_id"><font point-size="11">PAYEE_ACCOUNT_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="eod_run_id"><font point-size="11">EOD_RUN_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 37 columns</font></td></tr></table>>];
  "dsb_voucher_line" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>DSB_VOUCHER_LINE</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="voucher_id"><font point-size="11">VOUCHER_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 15 columns</font></td></tr></table>>];
  "dsb_voucher_tag" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>DSB_VOUCHER_TAG</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="voucher_id"><font point-size="11">VOUCHER_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 16 columns</font></td></tr></table>>];
  "pay_bank_account" [shape=box, style="rounded,filled", fillcolor="@DIRTY_WHITE", color="@MUTED", fontsize=11, label=<<font color="@MUTED">PAY_BANK_ACCOUNT<br/><font point-size="9">PAYABLES</font></font>>];
  "stored_file" [shape=box, style="rounded,filled", fillcolor="@DIRTY_WHITE", color="@MUTED", fontsize=11, label=<<font color="@MUTED">STORED_FILE<br/><font point-size="9">STORAGE</font></font>>];
  "dsb_eod_output":"eod_run_id" -> "dsb_eod_run" [arrowtail=crow, arrowhead=teetee];
  "dsb_eod_output":"stored_file_id" -> "stored_file" [arrowtail=crow, arrowhead=teeodot];
  "dsb_instrument":"bank_account_id" -> "pay_bank_account" [arrowtail=crow, arrowhead=teeodot];
  "dsb_instrument":"eod_run_id" -> "dsb_eod_run" [arrowtail=crow, arrowhead=teeodot];
  "dsb_instrument":"voucher_id" -> "dsb_voucher" [arrowtail=crow, arrowhead=teetee];
  "dsb_instrument_event":"instrument_id" -> "dsb_instrument" [arrowtail=crow, arrowhead=teetee];
  "dsb_payee_account":"payee_id" -> "dsb_payee" [arrowtail=crow, arrowhead=teetee];
  "dsb_payee_request":"payee_id" -> "dsb_payee" [arrowtail=crow, arrowhead=teeodot];
  "dsb_request":"payee_id" -> "dsb_payee" [arrowtail=crow, arrowhead=teeodot];
  "dsb_request":"voucher_id" -> "dsb_voucher" [arrowtail=crow, arrowhead=teeodot];
  "dsb_status_edit":"instrument_id" -> "dsb_instrument" [arrowtail=crow, arrowhead=teetee];
  "dsb_voucher":"bank_account_id" -> "pay_bank_account" [arrowtail=crow, arrowhead=teeodot];
  "dsb_voucher":"eod_run_id" -> "dsb_eod_run" [arrowtail=crow, arrowhead=teeodot];
  "dsb_voucher":"payee_account_id" -> "dsb_payee_account" [arrowtail=crow, arrowhead=teeodot];
  "dsb_voucher":"payee_id" -> "dsb_payee" [arrowtail=crow, arrowhead=teetee];
  "dsb_voucher":"request_id" -> "dsb_request" [arrowtail=crow, arrowhead=teetee];
  "dsb_voucher_line":"voucher_id" -> "dsb_voucher" [arrowtail=crow, arrowhead=teetee];
  "dsb_voucher_tag":"voucher_id" -> "dsb_voucher" [arrowtail=crow, arrowhead=teetee];
}
