digraph erd {
  graph [rankdir=LR, fontname="Arial", nodesep=0.3, ranksep=0.8, pad=0.2, bgcolor="white"];
  node [shape=plain, fontname="Arial"];
  edge [color="@CTA_BLUE", arrowsize=0.8, penwidth=1.2, dir=both];
  "pay_bank_account" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>PAY_BANK_ACCOUNT</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="currency"><font point-size="11">CURRENCY</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 20 columns</font></td></tr></table>>];
  "pay_cheque_book" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>PAY_CHEQUE_BOOK</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="bank_account_id"><font point-size="11">BANK_ACCOUNT_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 13 columns</font></td></tr></table>>];
  "pay_pdc_event" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>PAY_PDC_EVENT</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="pdc_id"><font point-size="11">PDC_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 10 columns</font></td></tr></table>>];
  "pay_pdc_issued" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>PAY_PDC_ISSUED</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="voucher_id"><font point-size="11">VOUCHER_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="bank_account_id"><font point-size="11">BANK_ACCOUNT_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="party_id"><font point-size="11">PARTY_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="replaces_id"><font point-size="11">REPLACES_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="replaced_by_id"><font point-size="11">REPLACED_BY_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 24 columns</font></td></tr></table>>];
  "pay_petty_cash_disbursement" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>PAY_PETTY_CASH_DISBURSEMENT</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="fund_id"><font point-size="11">FUND_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="reimbursement_id"><font point-size="11">REIMBURSEMENT_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 20 columns</font></td></tr></table>>];
  "pay_petty_cash_fund" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>PAY_PETTY_CASH_FUND</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="replenish_bank_account_id"><font point-size="11">REPLENISH_BANK_ACCOUNT_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 18 columns</font></td></tr></table>>];
  "pay_petty_cash_reimbursement" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>PAY_PETTY_CASH_REIMBURSEMENT</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="fund_id"><font point-size="11">FUND_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="bank_account_id"><font point-size="11">BANK_ACCOUNT_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 16 columns</font></td></tr></table>>];
  "pay_voucher" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>PAY_VOUCHER</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="party_id"><font point-size="11">PARTY_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="bank_account_id"><font point-size="11">BANK_ACCOUNT_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="open_item_id"><font point-size="11">OPEN_ITEM_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 30 columns</font></td></tr></table>>];
  "pay_voucher_allocation" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>PAY_VOUCHER_ALLOCATION</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="voucher_id"><font point-size="11">VOUCHER_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="open_item_id"><font point-size="11">OPEN_ITEM_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 5 columns</font></td></tr></table>>];
  "cur_currency" [shape=box, style="rounded,filled", fillcolor="@DIRTY_WHITE", color="@MUTED", fontsize=11, label=<<font color="@MUTED">CUR_CURRENCY<br/><font point-size="9">CURRENCY</font></font>>];
  "pty_party" [shape=box, style="rounded,filled", fillcolor="@DIRTY_WHITE", color="@MUTED", fontsize=11, label=<<font color="@MUTED">PTY_PARTY<br/><font point-size="9">PARTY</font></font>>];
  "sl_open_item" [shape=box, style="rounded,filled", fillcolor="@DIRTY_WHITE", color="@MUTED", fontsize=11, label=<<font color="@MUTED">SL_OPEN_ITEM<br/><font point-size="9">SUBLEDGER</font></font>>];
  "pay_bank_account":"currency" -> "cur_currency" [arrowtail=crow, arrowhead=teetee];
  "pay_cheque_book":"bank_account_id" -> "pay_bank_account" [arrowtail=crow, arrowhead=teetee];
  "pay_pdc_event":"pdc_id" -> "pay_pdc_issued" [arrowtail=crow, arrowhead=teetee];
  "pay_pdc_issued":"bank_account_id" -> "pay_bank_account" [arrowtail=crow, arrowhead=teetee];
  "pay_pdc_issued":"party_id" -> "pty_party" [arrowtail=crow, arrowhead=teetee];
  "pay_pdc_issued":"replaced_by_id" -> "pay_pdc_issued" [arrowtail=crow, arrowhead=teeodot];
  "pay_pdc_issued":"replaces_id" -> "pay_pdc_issued" [arrowtail=crow, arrowhead=teeodot];
  "pay_pdc_issued":"voucher_id" -> "pay_voucher" [arrowtail=crow, arrowhead=teetee];
  "pay_petty_cash_disbursement":"fund_id" -> "pay_petty_cash_fund" [arrowtail=crow, arrowhead=teetee];
  "pay_petty_cash_disbursement":"reimbursement_id" -> "pay_petty_cash_reimbursement" [arrowtail=crow, arrowhead=teeodot];
  "pay_petty_cash_fund":"replenish_bank_account_id" -> "pay_bank_account" [arrowtail=crow, arrowhead=teetee];
  "pay_petty_cash_reimbursement":"bank_account_id" -> "pay_bank_account" [arrowtail=crow, arrowhead=teetee];
  "pay_petty_cash_reimbursement":"fund_id" -> "pay_petty_cash_fund" [arrowtail=crow, arrowhead=teetee];
  "pay_voucher":"bank_account_id" -> "pay_bank_account" [arrowtail=crow, arrowhead=teetee];
  "pay_voucher":"open_item_id" -> "sl_open_item" [arrowtail=crow, arrowhead=teeodot];
  "pay_voucher":"party_id" -> "pty_party" [arrowtail=crow, arrowhead=teetee];
  "pay_voucher_allocation":"open_item_id" -> "sl_open_item" [arrowtail=crow, arrowhead=teetee];
  "pay_voucher_allocation":"voucher_id" -> "pay_voucher" [arrowtail=crow, arrowhead=teetee];
}
