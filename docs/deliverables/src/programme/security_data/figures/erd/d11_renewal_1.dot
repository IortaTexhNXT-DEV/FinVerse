digraph erd {
  graph [rankdir=TB, fontname="Arial", nodesep=0.3, ranksep=0.8, pad=0.2, bgcolor="white"];
  node [shape=plain, fontname="Arial"];
  edge [color="@CTA_BLUE", arrowsize=0.8, penwidth=1.2, dir=both];
  "rnw_bucket_rule" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>RNW_BUCKET_RULE</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="rule_set_id"><font point-size="11">RULE_SET_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 10 columns</font></td></tr></table>>];
  "rnw_bucket_rule_set" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>RNW_BUCKET_RULE_SET</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 15 columns</font></td></tr></table>>];
  "rnw_budget" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>RNW_BUDGET</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 18 columns</font></td></tr></table>>];
  "rnw_budget_history" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>RNW_BUDGET_HISTORY</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="budget_id"><font point-size="11">BUDGET_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 5 columns</font></td></tr></table>>];
  "rnw_budget_month" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>RNW_BUDGET_MONTH</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="budget_id"><font point-size="11">BUDGET_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="month_no"><font point-size="11">MONTH_NO</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 3 columns</font></td></tr></table>>];
  "rnw_candidate" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>RNW_CANDIDATE</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="extraction_run_id"><font point-size="11">EXTRACTION_RUN_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 127 columns</font></td></tr></table>>];
  "rnw_channel_event" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>RNW_CHANNEL_EVENT</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="message_id"><font point-size="11">MESSAGE_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 4 columns</font></td></tr></table>>];
  "rnw_channel_message" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>RNW_CHANNEL_MESSAGE</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="candidate_id"><font point-size="11">CANDIDATE_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 26 columns</font></td></tr></table>>];
  "rnw_check_result" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>RNW_CHECK_RESULT</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="run_id"><font point-size="11">RUN_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="candidate_id"><font point-size="11">CANDIDATE_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 10 columns</font></td></tr></table>>];
  "rnw_check_run" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>RNW_CHECK_RUN</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="candidate_id"><font point-size="11">CANDIDATE_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 12 columns</font></td></tr></table>>];
  "rnw_extraction_run" [shape=box, style="rounded,filled", fillcolor="@DIRTY_WHITE", color="@MUTED", fontsize=11, label=<<font color="@MUTED">RNW_EXTRACTION_RUN<br/><font point-size="9">RENEWAL</font></font>>];
  "rnw_bucket_rule":"rule_set_id" -> "rnw_bucket_rule_set" [arrowtail=crow, arrowhead=teetee];
  "rnw_budget_history":"budget_id" -> "rnw_budget" [arrowtail=crow, arrowhead=teetee];
  "rnw_budget_month":"budget_id" -> "rnw_budget" [arrowtail=crow, arrowhead=teetee];
  "rnw_candidate":"extraction_run_id" -> "rnw_extraction_run" [arrowtail=crow, arrowhead=teeodot];
  "rnw_channel_event":"message_id" -> "rnw_channel_message" [arrowtail=crow, arrowhead=teetee];
  "rnw_channel_message":"candidate_id" -> "rnw_candidate" [arrowtail=crow, arrowhead=teeodot];
  "rnw_check_result":"candidate_id" -> "rnw_candidate" [arrowtail=crow, arrowhead=teetee];
  "rnw_check_result":"run_id" -> "rnw_check_run" [arrowtail=crow, arrowhead=teetee];
  "rnw_check_run":"candidate_id" -> "rnw_candidate" [arrowtail=crow, arrowhead=teetee];
}
