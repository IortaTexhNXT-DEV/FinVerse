digraph erd {
  graph [rankdir=TB, fontname="Arial", nodesep=0.3, ranksep=0.8, pad=0.2, bgcolor="white"];
  node [shape=plain, fontname="Arial"];
  edge [color="@CTA_BLUE", arrowsize=0.8, penwidth=1.2, dir=both];
  "rnw_assignment" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>RNW_ASSIGNMENT</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="candidate_id"><font point-size="11">CANDIDATE_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 9 columns</font></td></tr></table>>];
  "rnw_bucket_history" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>RNW_BUCKET_HISTORY</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="candidate_id"><font point-size="11">CANDIDATE_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 12 columns</font></td></tr></table>>];
  "rnw_candidate_endorsement" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>RNW_CANDIDATE_ENDORSEMENT</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="candidate_id"><font point-size="11">CANDIDATE_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 9 columns</font></td></tr></table>>];
  "rnw_disposition" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>RNW_DISPOSITION</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="candidate_id"><font point-size="11">CANDIDATE_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 13 columns</font></td></tr></table>>];
  "rnw_extraction_run" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>RNW_EXTRACTION_RUN</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 20 columns</font></td></tr></table>>];
  "rnw_followup" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>RNW_FOLLOWUP</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="candidate_id"><font point-size="11">CANDIDATE_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 9 columns</font></td></tr></table>>];
  "rnw_history_view" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>RNW_HISTORY_VIEW</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="candidate_id"><font point-size="11">CANDIDATE_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 6 columns</font></td></tr></table>>];
  "rnw_insurer_response" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>RNW_INSURER_RESPONSE</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="candidate_id"><font point-size="11">CANDIDATE_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 21 columns</font></td></tr></table>>];
  "rnw_lamd_line" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>RNW_LAMD_LINE</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="report_id"><font point-size="11">REPORT_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="candidate_id"><font point-size="11">CANDIDATE_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 13 columns</font></td></tr></table>>];
  "rnw_lamd_report" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>RNW_LAMD_REPORT</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 12 columns</font></td></tr></table>>];
  "rnw_candidate" [shape=box, style="rounded,filled", fillcolor="@DIRTY_WHITE", color="@MUTED", fontsize=11, label=<<font color="@MUTED">RNW_CANDIDATE<br/><font point-size="9">RENEWAL</font></font>>];
  "rnw_assignment":"candidate_id" -> "rnw_candidate" [arrowtail=crow, arrowhead=teetee];
  "rnw_bucket_history":"candidate_id" -> "rnw_candidate" [arrowtail=crow, arrowhead=teetee];
  "rnw_candidate_endorsement":"candidate_id" -> "rnw_candidate" [arrowtail=crow, arrowhead=teetee];
  "rnw_disposition":"candidate_id" -> "rnw_candidate" [arrowtail=crow, arrowhead=teetee];
  "rnw_followup":"candidate_id" -> "rnw_candidate" [arrowtail=crow, arrowhead=teetee];
  "rnw_history_view":"candidate_id" -> "rnw_candidate" [arrowtail=crow, arrowhead=teetee];
  "rnw_insurer_response":"candidate_id" -> "rnw_candidate" [arrowtail=crow, arrowhead=teetee];
  "rnw_lamd_line":"candidate_id" -> "rnw_candidate" [arrowtail=crow, arrowhead=teeodot];
  "rnw_lamd_line":"report_id" -> "rnw_lamd_report" [arrowtail=crow, arrowhead=teetee];
}
