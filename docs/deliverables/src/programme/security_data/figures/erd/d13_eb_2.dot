digraph erd {
  graph [rankdir=TB, fontname="Arial", nodesep=0.3, ranksep=0.8, pad=0.2, bgcolor="white"];
  node [shape=plain, fontname="Arial"];
  edge [color="@CTA_BLUE", arrowsize=0.8, penwidth=1.2, dir=both];
  "eb_activity_log" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>EB_ACTIVITY_LOG</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="programme_id"><font point-size="11">PROGRAMME_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="cycle_id"><font point-size="11">CYCLE_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 12 columns</font></td></tr></table>>];
  "eb_bor" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>EB_BOR</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="programme_id"><font point-size="11">PROGRAMME_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="cycle_id"><font point-size="11">CYCLE_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="attachment_id"><font point-size="11">ATTACHMENT_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 16 columns</font></td></tr></table>>];
  "eb_member" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>EB_MEMBER</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="roster_version_id"><font point-size="11">ROSTER_VERSION_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="programme_id"><font point-size="11">PROGRAMME_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 17 columns</font></td></tr></table>>];
  "eb_member_change" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>EB_MEMBER_CHANGE</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="programme_id"><font point-size="11">PROGRAMME_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 25 columns</font></td></tr></table>>];
  "eb_member_change_line" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>EB_MEMBER_CHANGE_LINE</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="member_change_id"><font point-size="11">MEMBER_CHANGE_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="member_id"><font point-size="11">MEMBER_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 16 columns</font></td></tr></table>>];
  "eb_programme" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>EB_PROGRAMME</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 17 columns</font></td></tr></table>>];
  "eb_roster_version" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>EB_ROSTER_VERSION</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="programme_id"><font point-size="11">PROGRAMME_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 14 columns</font></td></tr></table>>];
  "eb_submission" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>EB_SUBMISSION</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="programme_id"><font point-size="11">PROGRAMME_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="cycle_id"><font point-size="11">CYCLE_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="member_change_id"><font point-size="11">MEMBER_CHANGE_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 14 columns</font></td></tr></table>>];
  "eb_submission_document" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>EB_SUBMISSION_DOCUMENT</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="submission_id"><font point-size="11">SUBMISSION_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="attachment_id"><font point-size="11">ATTACHMENT_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 6 columns</font></td></tr></table>>];
  "eb_tracked_item" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>EB_TRACKED_ITEM</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="programme_id"><font point-size="11">PROGRAMME_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="cycle_id"><font point-size="11">CYCLE_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="member_id"><font point-size="11">MEMBER_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="member_change_id"><font point-size="11">MEMBER_CHANGE_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 23 columns</font></td></tr></table>>];
  "doc_attachment" [shape=box, style="rounded,filled", fillcolor="@DIRTY_WHITE", color="@MUTED", fontsize=11, label=<<font color="@MUTED">DOC_ATTACHMENT<br/><font point-size="9">ATTACHMENT</font></font>>];
  "eb_cycle" [shape=box, style="rounded,filled", fillcolor="@DIRTY_WHITE", color="@MUTED", fontsize=11, label=<<font color="@MUTED">EB_CYCLE<br/><font point-size="9">EB</font></font>>];
  "eb_activity_log":"cycle_id" -> "eb_cycle" [arrowtail=crow, arrowhead=teeodot];
  "eb_activity_log":"programme_id" -> "eb_programme" [arrowtail=crow, arrowhead=teetee];
  "eb_bor":"attachment_id" -> "doc_attachment" [arrowtail=crow, arrowhead=teetee];
  "eb_bor":"cycle_id" -> "eb_cycle" [arrowtail=crow, arrowhead=teetee];
  "eb_bor":"programme_id" -> "eb_programme" [arrowtail=crow, arrowhead=teetee];
  "eb_member":"programme_id" -> "eb_programme" [arrowtail=crow, arrowhead=teetee];
  "eb_member":"roster_version_id" -> "eb_roster_version" [arrowtail=crow, arrowhead=teetee];
  "eb_member_change":"programme_id" -> "eb_programme" [arrowtail=crow, arrowhead=teetee];
  "eb_member_change_line":"member_change_id" -> "eb_member_change" [arrowtail=crow, arrowhead=teetee];
  "eb_member_change_line":"member_id" -> "eb_member" [arrowtail=crow, arrowhead=teeodot];
  "eb_roster_version":"programme_id" -> "eb_programme" [arrowtail=crow, arrowhead=teetee];
  "eb_submission":"cycle_id" -> "eb_cycle" [arrowtail=crow, arrowhead=teeodot];
  "eb_submission":"programme_id" -> "eb_programme" [arrowtail=crow, arrowhead=teetee];
  "eb_submission":"member_change_id" -> "eb_member_change" [arrowtail=crow, arrowhead=teeodot];
  "eb_submission_document":"attachment_id" -> "doc_attachment" [arrowtail=crow, arrowhead=teetee];
  "eb_submission_document":"submission_id" -> "eb_submission" [arrowtail=crow, arrowhead=teetee];
  "eb_tracked_item":"cycle_id" -> "eb_cycle" [arrowtail=crow, arrowhead=teeodot];
  "eb_tracked_item":"member_change_id" -> "eb_member_change" [arrowtail=crow, arrowhead=teeodot];
  "eb_tracked_item":"member_id" -> "eb_member" [arrowtail=crow, arrowhead=teeodot];
  "eb_tracked_item":"programme_id" -> "eb_programme" [arrowtail=crow, arrowhead=teetee];
}
