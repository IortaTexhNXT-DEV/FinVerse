digraph erd {
  graph [rankdir=TB, fontname="Arial", nodesep=0.3, ranksep=0.8, pad=0.2, bgcolor="white"];
  node [shape=plain, fontname="Arial"];
  edge [color="@CTA_BLUE", arrowsize=0.8, penwidth=1.2, dir=both];
  "eb_client_confirmation" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>EB_CLIENT_CONFIRMATION</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="programme_id"><font point-size="11">PROGRAMME_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="cycle_id"><font point-size="11">CYCLE_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="comparative_id"><font point-size="11">COMPARATIVE_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="evidence_attachment_id"><font point-size="11">EVIDENCE_ATTACHMENT_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 11 columns</font></td></tr></table>>];
  "eb_comment" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>EB_COMMENT</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="comparative_id"><font point-size="11">COMPARATIVE_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="reply_to_id"><font point-size="11">REPLY_TO_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 7 columns</font></td></tr></table>>];
  "eb_comparative" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>EB_COMPARATIVE</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="programme_id"><font point-size="11">PROGRAMME_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="cycle_id"><font point-size="11">CYCLE_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="attachment_id"><font point-size="11">ATTACHMENT_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 18 columns</font></td></tr></table>>];
  "eb_comparative_line" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>EB_COMPARATIVE_LINE</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="comparative_id"><font point-size="11">COMPARATIVE_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="recommended_proposal_id"><font point-size="11">RECOMMENDED_PROPOSAL_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 7 columns</font></td></tr></table>>];
  "eb_comparative_signoff" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>EB_COMPARATIVE_SIGNOFF</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="comparative_id"><font point-size="11">COMPARATIVE_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 10 columns</font></td></tr></table>>];
  "eb_confirmation_line" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>EB_CONFIRMATION_LINE</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="confirmation_id"><font point-size="11">CONFIRMATION_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="proposal_id"><font point-size="11">PROPOSAL_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 11 columns</font></td></tr></table>>];
  "eb_cycle_account" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>EB_CYCLE_ACCOUNT</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="cycle_id"><font point-size="11">CYCLE_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="account_index"><font point-size="11">ACCOUNT_INDEX</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 1 columns</font></td></tr></table>>];
  "eb_document" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>EB_DOCUMENT</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="programme_id"><font point-size="11">PROGRAMME_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="cycle_id"><font point-size="11">CYCLE_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="attachment_id"><font point-size="11">ATTACHMENT_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 11 columns</font></td></tr></table>>];
  "eb_feedback" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>EB_FEEDBACK</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="programme_id"><font point-size="11">PROGRAMME_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="cycle_id"><font point-size="11">CYCLE_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 10 columns</font></td></tr></table>>];
  "eb_proposal" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>EB_PROPOSAL</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="programme_id"><font point-size="11">PROGRAMME_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="cycle_id"><font point-size="11">CYCLE_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="request_id"><font point-size="11">REQUEST_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="revision_id"><font point-size="11">REVISION_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="attachment_id"><font point-size="11">ATTACHMENT_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 20 columns</font></td></tr></table>>];
  "doc_attachment" [shape=box, style="rounded,filled", fillcolor="@DIRTY_WHITE", color="@MUTED", fontsize=11, label=<<font color="@MUTED">DOC_ATTACHMENT<br/><font point-size="9">ATTACHMENT</font></font>>];
  "eb_cycle" [shape=box, style="rounded,filled", fillcolor="@DIRTY_WHITE", color="@MUTED", fontsize=11, label=<<font color="@MUTED">EB_CYCLE<br/><font point-size="9">EB</font></font>>];
  "eb_insurer_request" [shape=box, style="rounded,filled", fillcolor="@DIRTY_WHITE", color="@MUTED", fontsize=11, label=<<font color="@MUTED">EB_INSURER_REQUEST<br/><font point-size="9">EB</font></font>>];
  "eb_programme" [shape=box, style="rounded,filled", fillcolor="@DIRTY_WHITE", color="@MUTED", fontsize=11, label=<<font color="@MUTED">EB_PROGRAMME<br/><font point-size="9">EB</font></font>>];
  "eb_revision_request" [shape=box, style="rounded,filled", fillcolor="@DIRTY_WHITE", color="@MUTED", fontsize=11, label=<<font color="@MUTED">EB_REVISION_REQUEST<br/><font point-size="9">EB</font></font>>];
  "eb_client_confirmation":"comparative_id" -> "eb_comparative" [arrowtail=crow, arrowhead=teeodot];
  "eb_client_confirmation":"cycle_id" -> "eb_cycle" [arrowtail=crow, arrowhead=teetee];
  "eb_client_confirmation":"evidence_attachment_id" -> "doc_attachment" [arrowtail=crow, arrowhead=teetee];
  "eb_client_confirmation":"programme_id" -> "eb_programme" [arrowtail=crow, arrowhead=teetee];
  "eb_comment":"comparative_id" -> "eb_comparative" [arrowtail=crow, arrowhead=teetee];
  "eb_comment":"reply_to_id" -> "eb_comment" [arrowtail=crow, arrowhead=teeodot];
  "eb_comparative":"attachment_id" -> "doc_attachment" [arrowtail=crow, arrowhead=teeodot];
  "eb_comparative":"cycle_id" -> "eb_cycle" [arrowtail=crow, arrowhead=teetee];
  "eb_comparative":"programme_id" -> "eb_programme" [arrowtail=crow, arrowhead=teetee];
  "eb_comparative_line":"comparative_id" -> "eb_comparative" [arrowtail=crow, arrowhead=teetee];
  "eb_comparative_line":"recommended_proposal_id" -> "eb_proposal" [arrowtail=crow, arrowhead=teeodot];
  "eb_comparative_signoff":"comparative_id" -> "eb_comparative" [arrowtail=crow, arrowhead=teetee];
  "eb_confirmation_line":"confirmation_id" -> "eb_client_confirmation" [arrowtail=crow, arrowhead=teetee];
  "eb_confirmation_line":"proposal_id" -> "eb_proposal" [arrowtail=crow, arrowhead=teetee];
  "eb_cycle_account":"cycle_id" -> "eb_cycle" [arrowtail=crow, arrowhead=teetee];
  "eb_document":"attachment_id" -> "doc_attachment" [arrowtail=crow, arrowhead=teetee];
  "eb_document":"cycle_id" -> "eb_cycle" [arrowtail=crow, arrowhead=teeodot];
  "eb_document":"programme_id" -> "eb_programme" [arrowtail=crow, arrowhead=teetee];
  "eb_feedback":"cycle_id" -> "eb_cycle" [arrowtail=crow, arrowhead=teetee];
  "eb_feedback":"programme_id" -> "eb_programme" [arrowtail=crow, arrowhead=teetee];
  "eb_proposal":"attachment_id" -> "doc_attachment" [arrowtail=crow, arrowhead=teetee];
  "eb_proposal":"cycle_id" -> "eb_cycle" [arrowtail=crow, arrowhead=teetee];
  "eb_proposal":"programme_id" -> "eb_programme" [arrowtail=crow, arrowhead=teetee];
  "eb_proposal":"request_id" -> "eb_insurer_request" [arrowtail=crow, arrowhead=teeodot];
  "eb_proposal":"revision_id" -> "eb_revision_request" [arrowtail=crow, arrowhead=teeodot];
}
