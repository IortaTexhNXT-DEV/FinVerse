digraph erd {
  graph [rankdir=TB, fontname="Arial", nodesep=0.3, ranksep=0.8, pad=0.2, bgcolor="white"];
  node [shape=plain, fontname="Arial"];
  edge [color="@CTA_BLUE", arrowsize=0.8, penwidth=1.2, dir=both];
  "eb_franchise_request" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>EB_FRANCHISE_REQUEST</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="programme_id"><font point-size="11">PROGRAMME_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="cycle_id"><font point-size="11">CYCLE_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="evidence_attachment_id"><font point-size="11">EVIDENCE_ATTACHMENT_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 20 columns</font></td></tr></table>>];
  "eb_programme_contact" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>EB_PROGRAMME_CONTACT</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="programme_id"><font point-size="11">PROGRAMME_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 12 columns</font></td></tr></table>>];
  "eb_programme_line" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>EB_PROGRAMME_LINE</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="programme_id"><font point-size="11">PROGRAMME_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 15 columns</font></td></tr></table>>];
  "eb_proposal_factor" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>EB_PROPOSAL_FACTOR</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="proposal_id"><font point-size="11">PROPOSAL_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 8 columns</font></td></tr></table>>];
  "eb_proposal_line" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>EB_PROPOSAL_LINE</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="proposal_id"><font point-size="11">PROPOSAL_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 13 columns</font></td></tr></table>>];
  "eb_renewal_advice" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>EB_RENEWAL_ADVICE</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="programme_id"><font point-size="11">PROGRAMME_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="cycle_id"><font point-size="11">CYCLE_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="attachment_id"><font point-size="11">ATTACHMENT_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 15 columns</font></td></tr></table>>];
  "doc_attachment" [shape=box, style="rounded,filled", fillcolor="@DIRTY_WHITE", color="@MUTED", fontsize=11, label=<<font color="@MUTED">DOC_ATTACHMENT<br/><font point-size="9">ATTACHMENT</font></font>>];
  "eb_cycle" [shape=box, style="rounded,filled", fillcolor="@DIRTY_WHITE", color="@MUTED", fontsize=11, label=<<font color="@MUTED">EB_CYCLE<br/><font point-size="9">EB</font></font>>];
  "eb_programme" [shape=box, style="rounded,filled", fillcolor="@DIRTY_WHITE", color="@MUTED", fontsize=11, label=<<font color="@MUTED">EB_PROGRAMME<br/><font point-size="9">EB</font></font>>];
  "eb_proposal" [shape=box, style="rounded,filled", fillcolor="@DIRTY_WHITE", color="@MUTED", fontsize=11, label=<<font color="@MUTED">EB_PROPOSAL<br/><font point-size="9">EB</font></font>>];
  "eb_franchise_request":"cycle_id" -> "eb_cycle" [arrowtail=crow, arrowhead=teetee];
  "eb_franchise_request":"evidence_attachment_id" -> "doc_attachment" [arrowtail=crow, arrowhead=teeodot];
  "eb_franchise_request":"programme_id" -> "eb_programme" [arrowtail=crow, arrowhead=teetee];
  "eb_programme_contact":"programme_id" -> "eb_programme" [arrowtail=crow, arrowhead=teetee];
  "eb_programme_line":"programme_id" -> "eb_programme" [arrowtail=crow, arrowhead=teetee];
  "eb_proposal_factor":"proposal_id" -> "eb_proposal" [arrowtail=crow, arrowhead=teetee];
  "eb_proposal_line":"proposal_id" -> "eb_proposal" [arrowtail=crow, arrowhead=teetee];
  "eb_renewal_advice":"attachment_id" -> "doc_attachment" [arrowtail=crow, arrowhead=teeodot];
  "eb_renewal_advice":"cycle_id" -> "eb_cycle" [arrowtail=crow, arrowhead=teetee];
  "eb_renewal_advice":"programme_id" -> "eb_programme" [arrowtail=crow, arrowhead=teetee];
}
