digraph erd {
  graph [rankdir=LR, fontname="Arial", nodesep=0.3, ranksep=0.8, pad=0.2, bgcolor="white"];
  node [shape=plain, fontname="Arial"];
  edge [color="@CTA_BLUE", arrowsize=0.8, penwidth=1.2, dir=both];
  "scr_case" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>SCR_CASE</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="match_version_id"><font point-size="11">MATCH_VERSION_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="risk_version_id"><font point-size="11">RISK_VERSION_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="approval_version_id"><font point-size="11">APPROVAL_VERSION_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="assignment_version_id"><font point-size="11">ASSIGNMENT_VERSION_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="sla_version_id"><font point-size="11">SLA_VERSION_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="validation_version_id"><font point-size="11">VALIDATION_VERSION_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="work_case_id"><font point-size="11">WORK_CASE_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 46 columns</font></td></tr></table>>];
  "scr_case_answer" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>SCR_CASE_ANSWER</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="review_id"><font point-size="11">REVIEW_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 10 columns</font></td></tr></table>>];
  "scr_case_document" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>SCR_CASE_DOCUMENT</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="case_id"><font point-size="11">CASE_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 13 columns</font></td></tr></table>>];
  "scr_case_event" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>SCR_CASE_EVENT</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="case_id"><font point-size="11">CASE_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 15 columns</font></td></tr></table>>];
  "scr_case_review" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>SCR_CASE_REVIEW</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="case_id"><font point-size="11">CASE_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="template_version_id"><font point-size="11">TEMPLATE_VERSION_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 9 columns</font></td></tr></table>>];
  "scr_committee_vote" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>SCR_COMMITTEE_VOTE</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="case_id"><font point-size="11">CASE_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 10 columns</font></td></tr></table>>];
  "scr_config_version" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>SCR_CONFIG_VERSION</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="base_version_id"><font point-size="11">BASE_VERSION_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 18 columns</font></td></tr></table>>];
  "scr_str" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>SCR_STR</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="case_id"><font point-size="11">CASE_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="template_version_id"><font point-size="11">TEMPLATE_VERSION_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="extraction_id"><font point-size="11">EXTRACTION_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 19 columns</font></td></tr></table>>];
  "scr_str_extraction" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>SCR_STR_EXTRACTION</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="layout_version_id"><font point-size="11">LAYOUT_VERSION_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 17 columns</font></td></tr></table>>];
  "scr_str_extraction_item" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>SCR_STR_EXTRACTION_ITEM</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="extraction_id"><font point-size="11">EXTRACTION_ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="str_id"><font point-size="11">STR_ID</font></td></tr></table>>];
  "scr_str_field" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>SCR_STR_FIELD</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="str_id"><font point-size="11">STR_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 7 columns</font></td></tr></table>>];
  "scr_str_transaction" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>SCR_STR_TRANSACTION</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="str_id"><font point-size="11">STR_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 11 columns</font></td></tr></table>>];
  "wf_case" [shape=box, style="rounded,filled", fillcolor="@DIRTY_WHITE", color="@MUTED", fontsize=11, label=<<font color="@MUTED">WF_CASE<br/><font point-size="9">WORKFLOW</font></font>>];
  "scr_case":"approval_version_id" -> "scr_config_version" [arrowtail=crow, arrowhead=teeodot];
  "scr_case":"assignment_version_id" -> "scr_config_version" [arrowtail=crow, arrowhead=teeodot];
  "scr_case":"match_version_id" -> "scr_config_version" [arrowtail=crow, arrowhead=teeodot];
  "scr_case":"risk_version_id" -> "scr_config_version" [arrowtail=crow, arrowhead=teeodot];
  "scr_case":"sla_version_id" -> "scr_config_version" [arrowtail=crow, arrowhead=teeodot];
  "scr_case":"validation_version_id" -> "scr_config_version" [arrowtail=crow, arrowhead=teeodot];
  "scr_case":"work_case_id" -> "wf_case" [arrowtail=crow, arrowhead=teeodot];
  "scr_case_answer":"review_id" -> "scr_case_review" [arrowtail=crow, arrowhead=teetee];
  "scr_case_document":"case_id" -> "scr_case" [arrowtail=crow, arrowhead=teetee];
  "scr_case_event":"case_id" -> "scr_case" [arrowtail=crow, arrowhead=teetee];
  "scr_case_review":"case_id" -> "scr_case" [arrowtail=crow, arrowhead=teetee];
  "scr_case_review":"template_version_id" -> "scr_config_version" [arrowtail=crow, arrowhead=teetee];
  "scr_committee_vote":"case_id" -> "scr_case" [arrowtail=crow, arrowhead=teetee];
  "scr_config_version":"base_version_id" -> "scr_config_version" [arrowtail=crow, arrowhead=teeodot];
  "scr_str":"case_id" -> "scr_case" [arrowtail=crow, arrowhead=teetee];
  "scr_str":"extraction_id" -> "scr_str_extraction" [arrowtail=crow, arrowhead=teeodot];
  "scr_str":"template_version_id" -> "scr_config_version" [arrowtail=crow, arrowhead=teeodot];
  "scr_str_extraction":"layout_version_id" -> "scr_config_version" [arrowtail=crow, arrowhead=teetee];
  "scr_str_extraction_item":"extraction_id" -> "scr_str_extraction" [arrowtail=crow, arrowhead=teetee];
  "scr_str_extraction_item":"str_id" -> "scr_str" [arrowtail=crow, arrowhead=teetee];
  "scr_str_field":"str_id" -> "scr_str" [arrowtail=crow, arrowhead=teetee];
  "scr_str_transaction":"str_id" -> "scr_str" [arrowtail=crow, arrowhead=teetee];
}
