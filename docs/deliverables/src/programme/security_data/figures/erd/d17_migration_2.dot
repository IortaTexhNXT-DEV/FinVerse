digraph erd {
  graph [layout=neato, overlap=prism, overlap_scaling=-4, sep="+12", splines=true, fontname="Arial", nodesep=0.3, ranksep=0.8, pad=0.2, bgcolor="white"];
  node [shape=plain, fontname="Arial"];
  edge [color="@CTA_BLUE", arrowsize=0.8, penwidth=1.2, dir=both];
  "mig_archive_record" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>MIG_ARCHIVE_RECORD</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="batch_id"><font point-size="11">BATCH_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 22 columns</font></td></tr></table>>];
  "mig_code_map_entry" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>MIG_CODE_MAP_ENTRY</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="version_id"><font point-size="11">VERSION_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 8 columns</font></td></tr></table>>];
  "mig_code_map_set" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>MIG_CODE_MAP_SET</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 16 columns</font></td></tr></table>>];
  "mig_code_map_version" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>MIG_CODE_MAP_VERSION</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="set_code"><font point-size="11">SET_CODE</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 13 columns</font></td></tr></table>>];
  "mig_cutover_plan" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>MIG_CUTOVER_PLAN</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 15 columns</font></td></tr></table>>];
  "mig_cutover_task" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>MIG_CUTOVER_TASK</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="plan_id"><font point-size="11">PLAN_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 19 columns</font></td></tr></table>>];
  "mig_gonogo_criterion" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>MIG_GONOGO_CRITERION</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="plan_id"><font point-size="11">PLAN_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 14 columns</font></td></tr></table>>];
  "mig_gonogo_decision" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>MIG_GONOGO_DECISION</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="plan_id"><font point-size="11">PLAN_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 6 columns</font></td></tr></table>>];
  "mig_recon_line" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>MIG_RECON_LINE</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="run_id"><font point-size="11">RUN_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 21 columns</font></td></tr></table>>];
  "mig_recon_run" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" color="@BORDER"><tr><td bgcolor="@HEADER_BLUE" align="left" colspan="2"><font color="@WHITE" point-size="12"><b>MIG_RECON_RUN</b></font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">PK</font></td><td align="left" port="id"><font point-size="11">ID</font></td></tr><tr><td align="left"><font point-size="10" color="@MUTED">FK</font></td><td align="left" port="batch_id"><font point-size="11">BATCH_ID</font></td></tr><tr><td colspan="2" align="left"><font point-size="10" color="@MUTED">+ 14 columns</font></td></tr></table>>];
  "mig_batch" [shape=box, style="rounded,filled", fillcolor="@DIRTY_WHITE", color="@MUTED", fontsize=11, label=<<font color="@MUTED">MIG_BATCH<br/><font point-size="9">MIGRATION</font></font>>];
  "mig_archive_record":"batch_id" -> "mig_batch" [arrowtail=crow, arrowhead=teetee];
  "mig_code_map_entry":"version_id" -> "mig_code_map_version" [arrowtail=crow, arrowhead=teetee];
  "mig_code_map_version":"set_code" -> "mig_code_map_set" [arrowtail=crow, arrowhead=teetee];
  "mig_cutover_task":"plan_id" -> "mig_cutover_plan" [arrowtail=crow, arrowhead=teetee];
  "mig_gonogo_criterion":"plan_id" -> "mig_cutover_plan" [arrowtail=crow, arrowhead=teetee];
  "mig_gonogo_decision":"plan_id" -> "mig_cutover_plan" [arrowtail=crow, arrowhead=teetee];
  "mig_recon_line":"run_id" -> "mig_recon_run" [arrowtail=crow, arrowhead=teetee];
  "mig_recon_run":"batch_id" -> "mig_batch" [arrowtail=crow, arrowhead=teeodot];
}
